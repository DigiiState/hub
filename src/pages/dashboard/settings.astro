---
import Layout from '../../layouts/Layout.astro';

const accountSettings = {
	email: "info@digiistate.com",
	role: "Administrator",
	plan: "National Institutional",
	timezone: "America/New_York (ET)"
};
---

<Layout title="Account Settings | DigiiState OS">
	<main class="min-h-screen bg-slate-50 flex">
		<aside class="w-64 bg-slate-950 text-white flex flex-col p-6 fixed h-full">
			<div class="text-xl font-black tracking-tighter italic mb-12">Digii<span class="text-blue-500">State</span></div>
			<nav class="flex-1 space-y-1">
				<a href="/dashboard" class="flex items-center gap-3 px-4 py-3 text-slate-400 hover:text-white text-xs font-bold uppercase tracking-widest transition-colors"><span>📊</span> Dashboard</a>
				<a href="/dashboard/territories" class="flex items-center gap-3 px-4 py-3 text-slate-400 hover:text-white text-xs font-bold uppercase tracking-widest transition-colors"><span>🗺️</span> Territories</a>
				<a href="/dashboard/leads" class="flex items-center gap-3 px-4 py-3 text-slate-400 hover:text-white text-xs font-bold uppercase tracking-widest transition-colors"><span>📞</span> Lead Ledger</a>
				<a href="/dashboard/renewals" class="flex items-center gap-3 px-4 py-3 text-slate-400 hover:text-white text-xs font-bold uppercase tracking-widest transition-colors"><span>⏳</span> Renewals</a>
				<a href="/dashboard/settings" class="flex items-center gap-3 px-4 py-3 bg-blue-600 rounded-xl text-xs font-bold uppercase tracking-widest"><span>⚙️</span> Settings</a>
			</nav>
		</aside>

		<div class="flex-1 ml-64 p-10">
			<h1 class="text-3xl font-black text-slate-950 uppercase tracking-tight mb-12">Account Settings</h1>
			
			<div class="max-w-2xl space-y-8">
				<div class="bg-white border border-slate-200 rounded-[40px] shadow-sm p-10">
					<h3 class="text-xs font-black uppercase tracking-widest text-slate-400 mb-8">Brokerage Profile</h3>
					<div class="space-y-6">
						<div class="flex justify-between items-center py-4 border-b border-slate-50">
							<span class="text-xs font-bold text-slate-500 uppercase">Operator ID</span>
							<span class="text-sm font-black text-slate-950">{accountSettings.email}</span>
						</div>
						<div class="flex justify-between items-center py-4 border-b border-slate-50">
							<span class="text-xs font-bold text-slate-500 uppercase">System Role</span>
							<span class="text-sm font-black text-blue-600 uppercase">{accountSettings.role}</span>
						</div>
						<div class="flex justify-between items-center py-4 border-b border-slate-50">
							<span class="text-xs font-bold text-slate-500 uppercase">Subscription Plan</span>
							<span class="text-sm font-black text-slate-950">{accountSettings.plan}</span>
						</div>
						<div class="flex justify-between items-center py-4">
							<span class="text-xs font-bold text-slate-500 uppercase">System Timezone</span>
							<span class="text-sm font-black text-slate-950">{accountSettings.timezone}</span>
						</div>
					</div>
				</div>

				<div class="bg-white border border-slate-200 rounded-[40px] shadow-sm p-10">
					<h3 class="text-xs font-black uppercase tracking-widest text-slate-400 mb-8">Security & Protocol</h3>
					<div class="space-y-6">
						<button class="w-full text-left flex justify-between items-center py-4 border-b border-slate-50 group hover:px-2 transition-all">
							<span class="text-xs font-bold text-slate-500 uppercase">Update Access Key</span>
							<span class="text-blue-600 font-bold text-xs group-hover:underline">Edit &rarr;</span>
						</button>
						<button class="w-full text-left flex justify-between items-center py-4 border-b border-slate-50 group hover:px-2 transition-all">
							<span class="text-xs font-bold text-slate-500 uppercase">Two-Factor Authentication</span>
							<span class="text-emerald-600 font-bold text-xs uppercase">Enabled</span>
						</button>
						<button class="w-full text-left flex justify-between items-center py-4 group hover:px-2 transition-all">
							<span class="text-xs font-bold text-slate-500 uppercase">API Access Tokens</span>
							<span class="text-blue-600 font-bold text-xs group-hover:underline">Manage &rarr;</span>
						</button>
					</div>
				</div>
			</div>
		</div>
	</main>
</Layout>
