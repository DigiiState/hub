---
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../../components/Sidebar.astro';
import { getCalls, getPortfolioStats } from '../../lib/db';

const calls = await getCalls();
const portfolioStats = await getPortfolioStats();

// Grouping and Metrics
const answeredCalls = calls?.filter(c => c.duration > 0).length || 0;
const missedCalls = (calls?.length || 0) - answeredCalls;
const answerRate = calls?.length > 0 ? ((answeredCalls / calls.length) * 100).toFixed(1) : 0;
---

<Layout title="Calls & Leads Center | DigiiState OS">
	<main class="min-h-screen bg-slate-50 flex">
		<Sidebar activePath="/dashboard/calls" />

		<div class="flex-1 ml-64 p-12">
			<header class="flex justify-between items-end mb-16">
				<div>
					<h1 class="text-4xl font-black text-slate-950 uppercase tracking-tighter leading-none">CALLS & LEADS CENTER</h1>
					<p class="text-slate-400 text-[10px] font-black uppercase tracking-[0.3em] mt-3">Deterministic Attribution & Lead Governance</p>
				</div>
				<div class="flex gap-4">
					<div class="bg-white border border-slate-200 p-6 rounded-3xl flex gap-8 shadow-sm">
						<div>
							<span class="text-[9px] font-black text-slate-400 uppercase block mb-1">Answer Rate</span>
							<b class="text-xl text-emerald-600">{answerRate}%</b>
						</div>
						<div class="w-px h-8 bg-slate-100"></div>
						<div>
							<span class="text-[9px] font-black text-slate-400 uppercase block mb-1">Missed Calls</span>
							<b class="text-xl text-red-500">{missedCalls}</b>
						</div>
					</div>
				</div>
			</header>

			<!-- CALLS LEDGER -->
			<section class="bg-white border border-slate-200 rounded-[40px] shadow-sm overflow-hidden">
				<div class="p-8 border-b border-slate-50 flex justify-between items-center">
					<h3 class="text-xs font-black uppercase tracking-widest text-slate-950">Inbound Activity</h3>
					<div class="flex gap-2">
						<button class="px-4 py-2 bg-slate-50 text-[10px] font-black uppercase tracking-widest rounded-xl hover:bg-slate-100 transition-all">Export CSV</button>
					</div>
				</div>
				<div class="overflow-x-auto">
					<table class="w-full text-left text-sm whitespace-nowrap">
						<thead>
							<tr class="bg-slate-50 text-[9px] uppercase font-black tracking-widest text-slate-400 border-b border-slate-100">
								<th class="px-8 py-5">Timestamp</th>
								<th class="px-8 py-5">Caller</th>
								<th class="px-8 py-5">Digital Site</th>
								<th class="px-8 py-5 text-center">Duration</th>
								<th class="px-8 py-5">Status</th>
								<th class="px-8 py-5">Recording</th>
								<th class="px-8 py-5 text-right">Action</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-slate-50">
							{calls?.map(c => (
								<tr class="hover:bg-slate-50/50 transition-colors group">
									<td class="px-8 py-6">
										<b class="text-slate-950 block">{new Date(c.started_at).toLocaleString()}</b>
										<span class="text-[9px] text-slate-400 font-mono font-bold uppercase">{c.twilio_call_sid}</span>
									</td>
									<td class="px-8 py-6">
										<b class="text-slate-950">{c.caller_number}</b>
									</td>
									<td class="px-8 py-6 text-[10px] font-black text-slate-600 uppercase italic">
										{c.assets?.niche} | {c.assets?.city}
									</td>
									<td class="px-8 py-6 text-center font-mono text-[10px] font-bold text-slate-400">
										{c.duration ? `${c.duration}s` : '--'}
									</td>
									<td class="px-8 py-6">
										<span class={`px-2 py-0.5 rounded text-[8px] font-black uppercase ${c.status === 'completed' ? 'bg-emerald-50 text-emerald-600' : 'bg-red-50 text-red-600'}`}>
											{c.status}
										</span>
									</td>
									<td class="px-8 py-6">
										{c.call_recordings?.[0] ? (
											<button 
												onclick={`playRecording('${c.call_recordings[0].id}')`}
												class="flex items-center gap-2 text-blue-600 hover:text-blue-800 transition-colors"
											>
												<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z"></path></svg>
												<span class="text-[9px] font-black uppercase tracking-widest">Listen</span>
											</button>
										) : (
											<span class="text-[9px] text-slate-300 font-black uppercase tracking-widest italic">No Recording</span>
										)}
									</td>
									<td class="px-8 py-6 text-right">
										<a href={`/dashboard/leads/${c.lead_id}`} class="text-[10px] font-black uppercase tracking-widest text-slate-400 hover:text-blue-600 transition-all">Details &rarr;</a>
									</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</section>
		</div>
	</main>

	<!-- PLAYER MODAL -->
	<div id="playerModal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-6">
		<div class="bg-white w-full max-w-lg rounded-[40px] shadow-2xl overflow-hidden relative p-12 text-center">
			<button onclick="closePlayer()" class="absolute top-8 right-8 text-slate-400 hover:text-slate-950 transition-colors">
				<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
			</button>
			<h3 class="text-xl font-black text-slate-950 mb-8 uppercase italic tracking-tighter">Call Recording</h3>
			<audio id="audioPlayer" controls class="w-full mb-8"></audio>
			<div class="text-[9px] font-black text-slate-400 uppercase tracking-widest">
				Security Gated Playback (v1.3.1 Proxy Active)
			</div>
		</div>
	</div>

	<script is:inline>
		window.playRecording = async (recordingId) => {
			const player = document.getElementById('audioPlayer');
			const modal = document.getElementById('playerModal');
			
			// In production, this would call a secure proxy API
			player.src = `/api/media/playback?id=${recordingId}`;
			modal.classList.remove('hidden');
			player.play();
		};

		window.closePlayer = () => {
			const player = document.getElementById('audioPlayer');
			const modal = document.getElementById('playerModal');
			player.pause();
			modal.classList.add('hidden');
		};
	</script>
</Layout>
