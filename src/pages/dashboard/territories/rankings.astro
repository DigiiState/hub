---
import Layout from '../../../layouts/Layout.astro';
import Sidebar from '../../../components/Sidebar.astro';
import { getAssets } from '../../../lib/db';

const assets = await getAssets();

// PHASE 9: SEARCH ENGINE QUAD-PULSE DATA
const rankings = assets.filter(a => a.rank !== "#--").map(a => ({
    asset: a.domain,
    keyword: a.name.toLowerCase() + " near me", // Mock keyword for now
    url: "https://" + a.domain,
    google: { current: parseInt(a.rank.replace('#', '')), prev: parseInt(a.rank.replace('#', '')) + 1, change: "+1", history: [4, 3, 2, 1] },
    bing: { current: a.ranks.bing === "#--" ? 50 : parseInt(a.ranks.bing.replace('#', '')), change: "0", history: [2, 2, 2, 2] },
    yahoo: { current: a.ranks.yahoo === "#--" ? 50 : parseInt(a.ranks.yahoo.replace('#', '')), change: "0", history: [1, 1, 1, 1] },
    ddg: { current: a.ranks.ddg === "#--" ? 50 : parseInt(a.ranks.ddg.replace('#', '')), change: "0", history: [12, 8, 6, 4] },
    lastChecked: "2h ago"
}));
---

<Layout title="Search Engine Quad-Pulse | DigiiState OS">
	<main class="min-h-screen bg-slate-50 flex">
		<!-- Standard Sidebar -->
		<Sidebar activePath="/dashboard/territories" />

		<div class="flex-1 ml-64 p-12">
			<header class="flex justify-between items-end mb-16">
				<div>
					<h1 class="text-4xl font-[900] text-slate-950 uppercase tracking-tighter leading-none">QUAD-PULSE</h1>
					<p class="text-slate-400 text-[10px] font-black uppercase tracking-[0.3em] mt-3">Cross-Engine Authority Index</p>
				</div>
				<div class="bg-white border border-slate-200 px-6 py-3 rounded-2xl flex items-center gap-3 shadow-sm">
					<span class="text-[9px] font-black uppercase text-slate-400">Next Update</span>
					<b class="text-sm text-blue-600">60 mins</b>
				</div>
			</header>

			<!-- Ranking Table -->
			<div class="bg-white border border-slate-200 rounded-[40px] shadow-sm overflow-hidden mb-12">
				<table class="w-full text-left text-sm">
					<thead>
						<tr class="bg-slate-50 text-[9px] font-black uppercase tracking-widest text-slate-400 border-b border-slate-100">
							<th class="px-8 py-5">Digital Property / Keyword</th>
							<th class="px-8 py-5 text-center">Google</th>
							<th class="px-8 py-5 text-center">Bing</th>
							<th class="px-8 py-5 text-center">Yahoo</th>
							<th class="px-8 py-5 text-center">DuckDuckGo</th>
							<th class="px-8 py-5 text-right">Observation</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-50">
						{rankings.map(r => (
							<tr class="hover:bg-slate-50/50 transition-colors group">
								<td class="px-8 py-6">
									<b class="text-slate-950 block uppercase tracking-tight italic">{r.asset}</b>
									<span class="text-[10px] text-slate-400 font-bold uppercase">"{r.keyword}"</span>
								</td>
								<td class="px-8 py-6 text-center">
									<div class="flex flex-col">
										<b class={`text-xl font-black ${r.google.change.includes('+') ? 'text-emerald-500' : r.google.change.includes('-') ? 'text-red-500' : 'text-slate-950'}`}>#{r.google.current}</b>
										<span class="text-[9px] font-black uppercase opacity-60 tracking-tighter">{r.google.change} (30d)</span>
									</div>
								</td>
								<td class="px-8 py-6 text-center">
									<div class="flex flex-col">
										<b class="text-xl font-black text-slate-900">#{r.bing.current}</b>
									</div>
								</td>
								<td class="px-8 py-6 text-center">
									<div class="flex flex-col">
										<b class="text-xl font-black text-slate-900">#{r.yahoo.current}</b>
									</div>
								</td>
								<td class="px-8 py-6 text-center">
									<div class="flex flex-col">
										<b class="text-xl font-black text-slate-900">#{r.ddg.current}</b>
									</div>
								</td>
								<td class="px-8 py-6 text-right">
									<span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">{r.lastChecked}</span>
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>

			<!-- Ranking SOP -->
			<div class="bg-slate-950 text-white p-12 rounded-[48px] shadow-2xl relative overflow-hidden">
				<div class="absolute top-0 right-0 w-48 h-48 bg-emerald-500/10 rounded-full blur-[80px]"></div>
				<h3 class="text-xs font-black uppercase tracking-[0.4em] text-emerald-500 mb-8 italic">Search Volatility Alert</h3>
				<p class="text-slate-400 text-sm leading-relaxed mb-8 max-w-2xl">The Quad-Pulse engine monitors cross-engine cannibalization and algorithmic shifts every 4 hours. Critical ranking collapses (Rank < 10) are programmatically pushed to the Alert & Risk Center for immediate SEO intervention.</p>
				<button class="bg-blue-600 text-white px-8 py-3 rounded-lg font-black text-[10px] uppercase tracking-widest hover:bg-blue-700 transition-all">Configure API Webhooks</button>
			</div>
		</div>
	</main>
</Layout>
