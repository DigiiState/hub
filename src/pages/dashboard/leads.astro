---
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../../components/Sidebar.astro';
import { getLeads, getPortfolioStats } from '../../lib/db';

const leads = await getLeads();
const portfolioStats = await getPortfolioStats();
---

<Layout title="Lead Ledger | DigiiState OS">
	<main class="min-h-screen bg-slate-50 flex">
		<!-- Standard Sidebar -->
		<Sidebar activePath="/dashboard/leads" />

		<div class="flex-1 ml-64 p-12">
			<header class="flex justify-between items-end mb-16">
				<div>
					<h1 class="text-4xl font-[900] text-slate-950 uppercase tracking-tighter leading-none">LEAD LEDGER</h1>
					<p class="text-slate-400 text-[10px] font-black uppercase tracking-[0.3em] mt-3">Inquiry Triage & Revenue Attribution</p>
				</div>
				<div class="flex gap-4">
					<div class="bg-white border border-slate-200 px-6 py-3 rounded-2xl flex items-center gap-3 shadow-sm">
						<span class="text-[9px] font-black uppercase text-slate-400">Total Pipeline Value</span>
						<b class="text-sm text-emerald-600">${portfolioStats.totalPipelineValue.toLocaleString()}</b>
					</div>
				</div>
			</header>

			<!-- Advanced Lead Data Grid -->
			<div class="bg-white border border-slate-200 rounded-[40px] shadow-sm overflow-hidden">
				<div class="overflow-x-auto">
					<table class="w-full text-left text-sm whitespace-nowrap">
						<thead>
							<tr class="bg-slate-50 text-[9px] uppercase font-black tracking-widest text-slate-400 border-b border-slate-100">
								<th class="px-8 py-5">Timestamp / ID</th>
								<th class="px-8 py-5">Source / Keyword</th>
								<th class="px-8 py-5">Digital Property</th>
								<th class="px-8 py-5">Renter</th>
								<th class="px-8 py-5 text-center">Duration</th>
								<th class="px-8 py-5">Status</th>
								<th class="px-8 py-5 text-right">Value (Won)</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-slate-50">
							{leads.map(l => (
								<tr class="hover:bg-slate-50/50 transition-colors group">
									<td class="px-8 py-6">
										<b class="text-slate-950 block">{l.date}</b>
										<span class="text-[9px] text-slate-400 font-mono font-bold uppercase">{l.id}</span>
									</td>
									<td class="px-8 py-6">
										<div class="flex flex-col">
											<b class="text-slate-900 text-xs">{l.source}</b>
											<span class="text-[10px] text-blue-500 font-bold italic">"{l.keyword}"</span>
										</div>
									</td>
									<td class="px-8 py-6 text-[10px] font-black text-slate-600 uppercase italic">
										{l.asset}
									</td>
									<td class="px-8 py-6 text-xs font-bold text-slate-600">
										{l.renter}
									</td>
									<td class="px-8 py-6 text-center font-mono text-[10px] font-bold text-slate-400">
										{l.duration}
									</td>
									<td class="px-8 py-6">
										<div class="flex items-center gap-2">
											<span class={`px-2 py-0.5 rounded text-[8px] font-black uppercase ${l.status === 'Qualified' ? 'bg-emerald-50 text-emerald-600' : 'bg-slate-100 text-slate-400'}`}>
												{l.status}
											</span>
											{l.appointment && <span class="px-2 py-0.5 bg-blue-50 text-blue-600 rounded text-[8px] font-black uppercase">Appt</span>}
										</div>
									</td>
									<td class="px-8 py-6 text-right">
										<div class="flex flex-col">
											<b class="text-slate-950 text-sm">{l.revenue}</b>
											<span class="text-[9px] text-slate-400 font-bold uppercase">Est: {l.estValue}</span>
										</div>
									</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</main>
</Layout>
