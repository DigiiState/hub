---
import Layout from '../../../layouts/Layout.astro';
import Sidebar from '../../../components/Sidebar.astro';
import { getLeadTimeline, getLeads } from '../../../lib/db';

const { id } = Astro.params;
const timeline = await getLeadTimeline(id);
const leads = await getLeads();
const lead = leads.find(l => l.id === id);
---

<Layout title={`Lead Detail: ${id} | DigiiState OS`}>
	<main class="min-h-screen bg-slate-50 flex">
		<Sidebar activePath="/dashboard/calls" />

		<div class="flex-1 ml-64 p-12">
			<header class="flex justify-between items-end mb-16">
				<div>
					<div class="flex items-center gap-2 mb-4">
						<a href="/dashboard/calls" class="text-[9px] font-black text-slate-400 uppercase tracking-widest hover:text-blue-600">&larr; Back to Calls</a>
					</div>
					<h1 class="text-4xl font-black text-slate-950 uppercase tracking-tighter leading-none">LEAD TIMELINE</h1>
					<p class="text-slate-400 text-[10px] font-black uppercase tracking-[0.3em] mt-3">ID: {id}</p>
				</div>
			</header>

			<div class="grid lg:grid-cols-3 gap-12">
				<div class="lg:col-span-2">
					<!-- TIMELINE -->
					<section class="bg-white border border-slate-200 rounded-[40px] shadow-sm p-12">
						<h3 class="text-xs font-black uppercase tracking-widest text-slate-950 mb-12">Event Sequence</h3>
						<div class="space-y-12 relative">
							<div class="absolute left-[7px] top-2 bottom-2 w-px bg-slate-100"></div>
							
							{timeline?.map((event, index) => (
								<div class="relative pl-10">
									<div class={`absolute left-0 top-1.5 w-4 h-4 rounded-full border-2 border-white shadow-sm ${index === timeline.length - 1 ? 'bg-blue-600 animate-pulse' : 'bg-slate-200'}`}></div>
									<div class="flex justify-between items-start mb-2">
										<div>
											<b class="text-sm text-slate-950 uppercase tracking-tight">{event.new_state}</b>
											<span class="text-[9px] text-slate-400 font-black uppercase tracking-widest ml-3">{event.source}</span>
										</div>
										<time class="text-[9px] font-black text-slate-400 uppercase tracking-widest">{new Date(event.timestamp).toLocaleString()}</time>
									</div>
									<div class="bg-slate-50 p-6 rounded-2xl">
										<p class="text-xs text-slate-600 leading-relaxed">
											{event.previous_state ? `Status changed from ${event.previous_state} to ${event.new_state}.` : `Lead initiated via ${event.source}.`}
										</p>
										{event.actor_id && (
											<div class="mt-4 pt-4 border-t border-slate-100 flex items-center gap-2">
												<span class="text-[9px] font-black text-slate-400 uppercase tracking-widest">Actor:</span>
												<b class="text-[9px] font-black text-slate-950 uppercase tracking-widest">{event.profiles?.full_name}</b>
											</div>
										)}
									</div>
								</div>
							))}
						</div>
					</section>
				</div>

				<div class="space-y-8">
					<!-- LEAD DETAILS -->
					<section class="bg-slate-950 text-white p-10 rounded-[40px] shadow-2xl">
						<h3 class="text-xs font-black uppercase tracking-[0.3em] text-blue-500 mb-8 italic">Lead Summary</h3>
						<div class="space-y-6">
							<div>
								<span class="text-[9px] font-black text-slate-500 uppercase tracking-widest block mb-1">Customer Number</span>
								<b class="text-lg">{lead?.customer_phone || '--'}</b>
							</div>
							<div>
								<span class="text-[9px] font-black text-slate-500 uppercase tracking-widest block mb-1">Digital Site</span>
								<b class="text-lg uppercase tracking-tight">{lead?.assets?.domain || '--'}</b>
							</div>
							<div>
								<span class="text-[9px] font-black text-slate-500 uppercase tracking-widest block mb-1">Current Status</span>
								<span class="inline-block px-3 py-1 bg-blue-600 text-[10px] font-black uppercase tracking-widest rounded-lg mt-2">{lead?.status}</span>
							</div>
						</div>
					</section>

					<!-- ACTION PANEL -->
					<section class="bg-white border border-slate-200 p-10 rounded-[40px] shadow-sm">
						<h3 class="text-xs font-black uppercase tracking-widest text-slate-950 mb-8">Update Status</h3>
						<div class="grid gap-2">
							{['QUALIFIED', 'PROPOSAL', 'WON', 'LOST', 'SPAM'].map(status => (
								<button 
									class="w-full text-left px-6 py-4 rounded-2xl border border-slate-50 text-[10px] font-black uppercase tracking-widest hover:bg-slate-50 hover:border-blue-200 transition-all"
									onclick={`updateStatus('${status}')`}
								>
									Mark as {status}
								</button>
							))}
						</div>
					</section>
				</div>
			</div>
		</div>
	</main>

	<script is:inline>
		window.updateStatus = async (status) => {
			const leadId = window.location.pathname.split('/').pop();
			try {
				const res = await fetch(`/api/leads/status`, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ leadId, status })
				});
				if (res.ok) window.location.reload();
				else alert('Failed to update status');
			} catch (e) {
				alert('System Error');
			}
		};
	</script>
</Layout>
