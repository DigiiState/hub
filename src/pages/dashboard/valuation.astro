---
import Layout from '../../layouts/Layout.astro';

// PHASE 12: DIGITAL ASSET VALUATION DATA
const portfolioValuation = {
	totalInvestment: 12562.76,
	monthlyNOI: 3689.50,
	annualNOI: 44274.00,
	equityCreated: 18437.24,
	multiplier: "12x",
	totalValue: 531288.00
};

const valuationHistory = [
	{ date: "Aug 2026", value: "$531,288", change: "Launch" },
	{ date: "Jul 2026", value: "$412,000", change: "+$119k" },
	{ date: "Jun 2026", value: "$284,500", change: "+$127k" },
];
---

<Layout title="Portfolio Valuation | DigiiState OS">
	<main class="min-h-screen bg-slate-50 flex">
		<!-- Standard Sidebar -->
		<aside class="w-64 bg-slate-950 text-white flex flex-col p-6 fixed h-full shadow-2xl">
			<div class="text-2xl font-black tracking-tighter italic mb-12 text-center">Digii<span class="text-blue-500">State</span></div>
			<nav class="flex-1 space-y-1">
				<a href="/dashboard" class="flex items-center gap-3 px-4 py-2.5 text-slate-400 hover:text-white text-[10px] font-bold uppercase tracking-widest transition-all">Command Center</a>
				<a href="/dashboard/financials" class="flex items-center gap-3 px-4 py-2.5 text-slate-400 hover:text-white text-[10px] font-bold uppercase tracking-widest transition-all">Financials</a>
				<a href="/dashboard/valuation" class="flex items-center gap-3 px-4 py-2.5 bg-blue-600 rounded-xl text-[10px] font-bold uppercase tracking-widest transition-all">Valuation</a>
			</nav>
		</aside>

		<div class="flex-1 ml-64 p-12">
			<header class="flex justify-between items-end mb-16">
				<div>
					<h1 class="text-4xl font-[900] text-slate-950 uppercase tracking-tighter leading-none">VALUATION</h1>
					<p class="text-slate-400 text-[10px] font-black uppercase tracking-[0.3em] mt-3">Institutional Equity & Portfolio Appraisal</p>
				</div>
				<div class="bg-emerald-50 border border-emerald-100 px-6 py-3 rounded-2xl flex items-center gap-3 shadow-sm">
					<span class="text-[9px] font-black uppercase text-emerald-600">Total Asset Multiplier</span>
					<b class="text-sm text-slate-950">12x NOI</b>
				</div>
			</header>

			<!-- Valuation Hero -->
			<div class="bg-slate-950 text-white p-16 rounded-[60px] shadow-3xl mb-12 relative overflow-hidden text-center">
				<div class="absolute inset-0 bg-gradient-to-r from-blue-600/10 via-emerald-600/10 to-indigo-600/10 blur-3xl opacity-50"></div>
				<span class="text-[10px] font-black uppercase tracking-[0.5em] text-blue-500 mb-6 block relative z-10">Estimated Portfolio Value</span>
				<div class="text-8xl font-[900] tracking-tighter mb-4 relative z-10">${portfolioValuation.totalValue.toLocaleString()}</div>
				<p class="text-slate-400 text-sm font-bold uppercase tracking-widest relative z-10">Consolidated US Search Assets Index</p>
			</div>

			<div class="grid lg:grid-cols-2 gap-8">
				<!-- Equity Creation -->
				<div class="bg-white border border-slate-200 rounded-[48px] p-12 shadow-sm">
					<h3 class="text-xs font-black uppercase tracking-[0.4em] text-slate-400 mb-10 italic">Equity Audit</h3>
					<div class="space-y-8">
						<div class="flex justify-between items-center py-2 border-b border-slate-50">
							<span class="text-xs font-bold text-slate-500 uppercase tracking-widest">Initial Capital Base</span>
							<b class="text-sm text-slate-950">${portfolioValuation.totalInvestment.toLocaleString()}</b>
						</div>
						<div class="flex justify-between items-center py-2 border-b border-slate-50">
							<span class="text-xs font-bold text-slate-500 uppercase tracking-widest">Unrealized Equity Gain</span>
							<b class="text-sm text-emerald-600">+$518,725.24</b>
						</div>
						<div class="flex justify-between items-center pt-4">
							<span class="text-xs font-black uppercase text-blue-600 tracking-[0.3em]">Portfolio ROI</span>
							<b class="text-4xl font-black text-slate-950">4,128%</b>
						</div>
					</div>
				</div>

				<!-- Valuation History -->
				<div class="bg-white border border-slate-200 rounded-[48px] p-12 shadow-sm">
					<h3 class="text-xs font-black uppercase tracking-[0.4em] text-slate-400 mb-10 italic">Appraisal History</h3>
					<div class="space-y-6">
						{valuationHistory.map(v => (
							<div class="flex justify-between items-center py-4 border-b border-slate-50 last:border-0 group">
								<div>
									<b class="text-sm text-slate-950 uppercase block">{v.date}</b>
									<span class="text-[9px] text-emerald-500 font-black uppercase">{v.change}</span>
								</div>
								<b class="text-lg font-black text-slate-950">{v.value}</b>
							</div>
						))}
					</div>
				</div>
			</div>
		</div>
	</main>
</Layout>
