---
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../../components/Sidebar.astro';
import { assets } from '../../lib/db';

// PHASE 14: INTELLIGENCE ENGINE
const recommendations = [
	{ 
		id: "IQ-001",
		observation: "Baltimore Roofing leads declined 27% during the previous 30 days while rankings remained stable.",
		impact: "High risk of renter churn due to perceived value loss.",
		action: "Audit call tracking and conversion performance. Verify AI Triage logic on 'Swift Roof' landing page.",
		priority: "Critical",
		asset: "DEED-ROC-013",
        target: "/dashboard/portfolio"
	},
	{ 
		id: "IQ-002",
		observation: "Phoenix Septic reached Google #1 and generated 31 qualified leads last month.",
		impact: "Market dominance achieved ahead of schedule.",
		action: "Asset supports a rent increase of $150/mo. Consider upsell to National Expansion strategy.",
		priority: "Opportunity",
		asset: "DEED-PHX-001",
        target: "/dashboard/portfolio"
	},
	{ 
		id: "IQ-003",
		observation: "Columbia MD Septic territory scored 91/100 on the Acquisition Scorecard.",
		impact: "Low-competition blue ocean detected via Serper data.",
		action: "Initiate Acquisition Protocol. Secure 'columbiasepticpros.com' and deploy 45-page blanket.",
		priority: "Growth",
		asset: "TBD - Columbia, MD",
        target: "/dashboard/acquisitions"
	}
];
---

<Layout title="DigiiState Intelligence | Strategic Recommendations">
	<main class="min-h-screen bg-slate-50 flex">
		<!-- Standard Sidebar -->
		<Sidebar activePath="/dashboard/intelligence" />

		<div class="flex-1 ml-64 p-12">
			<header class="flex justify-between items-end mb-16">
				<div>
					<h1 class="text-4xl font-[900] text-slate-950 uppercase tracking-tighter leading-none">INTELLIGENCE</h1>
					<p class="text-slate-400 text-[10px] font-black uppercase tracking-[0.3em] mt-3">Algorithmic Portfolio Insights & Recommendations</p>
				</div>
				<div class="bg-slate-950 text-white px-8 py-4 rounded-xl text-[10px] font-black uppercase tracking-widest shadow-xl">
					Refresh Global Scan
				</div>
			</header>

			<!-- Recommendation Stack -->
			<div class="space-y-6">
				{recommendations.map(r => (
					<div class="bg-white border border-slate-200 rounded-[40px] p-10 shadow-sm relative overflow-hidden group hover:border-blue-300 transition-all">
						<div class={`absolute top-0 right-0 w-2 h-full ${r.priority === 'Critical' ? 'bg-red-500' : 'bg-blue-500'}`}></div>
						<div class="grid lg:grid-cols-4 gap-12">
							<div class="lg:col-span-1">
								<span class={`px-3 py-1 rounded-full text-[8px] font-black uppercase tracking-widest ${r.priority === 'Critical' ? 'bg-red-50 text-red-600' : 'bg-blue-50 text-blue-600'}`}>
									{r.priority}
								</span>
								<h3 class="text-[10px] font-black text-slate-400 uppercase tracking-widest mt-8 mb-2 italic">Observation</h3>
								<p class="text-sm font-bold text-slate-950 leading-relaxed">{r.observation}</p>
							</div>
							<div class="lg:col-span-1 border-l border-slate-50 pl-10">
								<h3 class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2 italic">Strategic Impact</h3>
								<p class="text-sm text-slate-600 leading-relaxed">{r.impact}</p>
							</div>
							<div class="lg:col-span-1 border-l border-slate-50 pl-10">
								<h3 class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2 italic">Recommended Action</h3>
								<p class="text-sm text-blue-600 font-bold leading-relaxed">{r.action}</p>
							</div>
							<div class="lg:col-span-1 flex flex-col justify-center items-end text-right border-l border-slate-50 pl-10">
								<span class="text-[9px] font-black text-slate-400 uppercase tracking-widest mb-1">Target Asset</span>
								<b class="text-xs text-slate-950 uppercase italic mb-6">{r.asset}</b>
								<a href={r.target} class="text-[10px] font-black text-center uppercase tracking-widest text-blue-600 border-2 border-blue-600 px-6 py-2.5 rounded-xl hover:bg-blue-600 hover:text-white transition-all active:scale-95">Execute &rarr;</a>
							</div>
						</div>
					</div>
				))}
			</div>
		</div>
	</main>
</Layout>
