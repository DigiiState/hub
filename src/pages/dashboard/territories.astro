---
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../../components/Sidebar.astro';

const territories = [
	{ id: "DEED-PHX-001", name: "Phoenix MD Septic", domain: "phoenixmdseptic.com", status: "Leased", owner: "Young Septic Services", ranking: "#1", health: 94 },
	{ id: "DEED-CLX-002", name: "Clarksville Septic", domain: "clarksvillesepticpros.com", status: "Ranking", owner: "None", ranking: "#8", health: 78 },
	{ id: "DEED-GIB-003", name: "Gibson Island Tree", domain: "gibsonislandtreeremoval.com", status: "Ranking", owner: "None", ranking: "#14", health: 64 },
    { id: "DEED-ANN-004", name: "Annapolis Tree", domain: "annapolistreepros.com", status: "Available", owner: "None", ranking: "#22", health: 82 },
];
---

<Layout title="Territory Manager | DigiiState OS">
	<main class="min-h-screen bg-slate-50 flex">
		<Sidebar activePath="/dashboard/territories" />

		<div class="flex-1 ml-64 p-12">
			<header class="flex justify-between items-end mb-16">
				<div>
					<h1 class="text-4xl font-black text-slate-950 uppercase tracking-tighter leading-none">TERRITORIES</h1>
					<p class="text-slate-400 text-[10px] font-black uppercase tracking-[0.3em] mt-3">Geographic Market Control & Digital Deed Allocation</p>
				</div>
				<div class="flex gap-4">
					<div class="bg-white border border-slate-200 px-6 py-3 rounded-2xl flex items-center gap-3 shadow-sm">
						<span class="text-[9px] font-black uppercase text-slate-400">Active Markets</span>
						<b class="text-sm text-slate-950">20</b>
					</div>
				</div>
			</header>

			<div class="bg-white border border-slate-200 rounded-[40px] shadow-sm overflow-hidden">
				<table class="w-full text-left">
					<thead class="bg-slate-50 border-b border-slate-100">
						<tr class="text-[10px] font-black uppercase text-slate-400 tracking-widest">
							<th class="px-8 py-5">Health</th>
							<th class="px-8 py-5">Territory / Digital Deed</th>
							<th class="px-8 py-5">Status</th>
							<th class="px-8 py-5">Operator / Renter</th>
							<th class="px-8 py-5 text-right">Primary Rank</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-50">
						{territories.map(t => (
							<tr class="hover:bg-slate-50/50 transition-colors group cursor-pointer" onclick={`window.location.href='/dashboard/territories/${t.id}'`}>
								<td class="px-8 py-6">
									<div class={`w-10 h-10 rounded-xl flex items-center justify-center font-black text-[10px] ${t.health >= 80 ? 'bg-emerald-50 text-emerald-600' : t.health >= 60 ? 'bg-amber-50 text-amber-600' : 'bg-red-50 text-red-600'}`}>
										{t.health}
									</div>
								</td>
								<td class="px-8 py-6">
									<b class="text-slate-950 block uppercase tracking-tight">{t.name}</b>
									<span class="text-[9px] text-slate-400 font-mono font-bold uppercase">{t.id} • {t.domain}</span>
								</td>
								<td class="px-8 py-6">
									<span class={`text-[9px] font-black uppercase px-3 py-1 rounded-full border ${t.status === 'Leased' ? 'bg-emerald-50 border-emerald-100 text-emerald-600' : 'bg-blue-50 border-blue-100 text-blue-600'}`}>
										{t.status}
									</span>
								</td>
								<td class="px-8 py-6 text-xs font-bold text-slate-600">
									{t.owner}
								</td>
								<td class="px-8 py-6 text-right">
									<b class="text-emerald-500 font-black">{t.ranking}</b>
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</div>
	</main>
</Layout>
