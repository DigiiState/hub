---
import Layout from '../../layouts/Layout.astro';

const territories = [
	{ name: "Phoenix MD Septic", domain: "phoenixmdseptic.com", status: "Leased", owner: "Young Septic Services", ranking: "#1" },
	{ name: "Clarksville Septic", domain: "clarksvillesepticpros.com", status: "Ranking", owner: "None", ranking: "#8" },
	{ name: "Gibson Island Tree", domain: "gibsonislandtreeremoval.com", status: "Ranking", owner: "None", ranking: "#14" },
];
---

<Layout title="Territory Manager | DigiiState OS">
	<main class="min-h-screen bg-slate-50 flex">
		<aside class="w-64 bg-slate-950 text-white flex flex-col p-6 fixed h-full">
			<div class="text-xl font-black tracking-tighter italic mb-12">Digii<span class="text-blue-500">State</span></div>
			<nav class="flex-1 space-y-1">
				<a href="/dashboard" class="flex items-center gap-3 px-4 py-3 text-slate-400 hover:text-white text-xs font-bold uppercase tracking-widest transition-colors"><span>📊</span> Dashboard</a>
				<a href="/dashboard/territories" class="flex items-center gap-3 px-4 py-3 bg-blue-600 rounded-xl text-xs font-bold uppercase tracking-widest"><span>🗺️</span> Territories</a>
				<a href="/dashboard/leads" class="flex items-center gap-3 px-4 py-3 text-slate-400 hover:text-white text-xs font-bold uppercase tracking-widest transition-colors"><span>📞</span> Lead Ledger</a>
				<a href="/dashboard/renters" class="flex items-center gap-3 px-4 py-3 text-slate-400 hover:text-white text-xs font-bold uppercase tracking-widest transition-colors"><span>💳</span> Renters</a>
				<a href="/dashboard/settings" class="flex items-center gap-3 px-4 py-3 text-slate-400 hover:text-white text-xs font-bold uppercase tracking-widest transition-colors"><span>⚙️</span> Settings</a>
			</nav>
		</aside>

		<div class="flex-1 ml-64 p-10">
			<h1 class="text-3xl font-black text-slate-950 uppercase tracking-tight mb-12">Territory Manager</h1>
			<div class="bg-white border border-slate-200 rounded-[40px] shadow-sm overflow-hidden">
				<table class="w-full text-left">
					<thead class="bg-slate-50 border-b border-slate-100">
						<tr class="text-[10px] font-black uppercase text-slate-400 tracking-widest">
							<th class="px-8 py-4">Territory</th>
							<th class="px-8 py-4">Status</th>
							<th class="px-8 py-4">Current Renter</th>
							<th class="px-8 py-4">Rank</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-50">
						{territories.map(t => (
							<tr class="hover:bg-slate-50 transition-colors group">
								<td class="px-8 py-6">
									<b class="text-slate-950 block">{t.name}</b>
									<span class="text-[10px] text-slate-400 font-bold">{t.domain}</span>
								</td>
								<td class="px-8 py-6">
									<span class={`text-[9px] font-black uppercase px-2 py-1 rounded-lg ${t.status === 'Leased' ? 'bg-amber-50 text-amber-600' : 'bg-blue-50 text-blue-600'}`}>{t.status}</span>
								</td>
								<td class="px-8 py-6 text-xs font-bold text-slate-600">{t.owner}</td>
								<td class="px-8 py-6 text-xs font-black text-emerald-500">{t.ranking}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</div>
	</main>
</Layout>
