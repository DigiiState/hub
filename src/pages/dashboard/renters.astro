---
import Layout from '../../layouts/Layout.astro';

// PHASE 7: INSTITUTIONAL RENTER DATA (Multi-Site Capable)
const renters = [
	{ 
		id: "R-001",
		businessName: "Young Septic Services", 
		owner: "Mike Young",
		territories: ["Phoenix, MD", "Clarksville, MD"],
		assetsLeased: 2,
		monthlyRent: 2500.00,
		status: "Current",
		lifetimeRevenue: 7500.00,
		leadsDelivered: 124,
		convRate: "28%"
	},
	{ 
		id: "R-002",
		businessName: "Prestige Tree Experts", 
		owner: "Sarah Miller",
		territories: ["Gibson Island, MD"],
		assetsLeased: 1,
		monthlyRent: 1250.00,
		status: "Current",
		lifetimeRevenue: 2500.00,
		leadsDelivered: 42,
		convRate: "31%"
	},
	{ 
		id: "R-003",
		businessName: "Portner & Shure", 
		owner: "Legal Manager",
		territories: ["Annapolis, MD"],
		assetsLeased: 1,
		monthlyRent: 2500.00,
		status: "Trial",
		lifetimeRevenue: 0.00,
		leadsDelivered: 8,
		convRate: "45%"
	}
];
---

<Layout title="Renter Management | DigiiState OS">
	<main class="min-h-screen bg-slate-50 flex">
		<!-- Standard Sidebar (Directive Compliant) -->
		<aside class="w-64 bg-slate-950 text-white flex flex-col p-6 fixed h-full shadow-2xl overflow-y-auto">
			<div class="text-2xl font-black tracking-tighter italic mb-12">Digii<span class="text-blue-500">State</span></div>
			<div class="space-y-8">
				<div>
					<h3 class="text-[10px] font-black text-slate-500 uppercase tracking-widest mb-4">Operations</h3>
					<nav class="space-y-1">
						<a href="/dashboard" class="flex items-center gap-3 px-4 py-2.5 text-slate-400 hover:text-white text-[10px] font-bold uppercase tracking-widest transition-all">Command Center</a>
						<a href="/dashboard/portfolio" class="flex items-center gap-3 px-4 py-2.5 text-slate-400 hover:text-white text-[10px] font-bold uppercase tracking-widest transition-all">Portfolio</a>
						<a href="/dashboard/territories" class="flex items-center gap-3 px-4 py-2.5 text-slate-400 hover:text-white text-[10px] font-bold uppercase tracking-widest transition-all">Territories</a>
						<a href="/dashboard/vault" class="flex items-center gap-3 px-4 py-2.5 text-slate-400 hover:text-white text-[10px] font-bold uppercase tracking-widest transition-all">Digital Vault</a>
						<a href="/dashboard/leads" class="flex items-center gap-3 px-4 py-2.5 text-slate-400 hover:text-white text-[10px] font-bold uppercase tracking-widest transition-all">Lead Ledger</a>
						<a href="/dashboard/renters" class="flex items-center gap-3 px-4 py-2.5 bg-blue-600 rounded-xl text-[10px] font-bold uppercase tracking-widest transition-all">Renters</a>
					</nav>
				</div>
                <div>
					<h3 class="text-[10px] font-black text-slate-500 uppercase tracking-widest mb-4">Growth</h3>
					<nav class="space-y-1">
						<a href="/dashboard/acquisitions" class="flex items-center gap-3 px-4 py-2.5 text-slate-400 hover:text-white text-[10px] font-bold uppercase tracking-widest transition-all">Acquisitions</a>
						<a href="/dashboard/intelligence" class="flex items-center gap-3 px-4 py-2.5 text-slate-400 hover:text-white text-[10px] font-bold uppercase tracking-widest transition-all">Intelligence</a>
					</nav>
				</div>
				<div>
					<h3 class="text-[10px] font-black text-slate-500 uppercase tracking-widest mb-4">Finance</h3>
					<nav class="space-y-1">
						<a href="/dashboard/financials" class="flex items-center gap-3 px-4 py-2.5 text-slate-400 hover:text-white text-[10px] font-bold uppercase tracking-widest transition-all">Financials</a>
						<a href="/dashboard/payouts" class="flex items-center gap-3 px-4 py-2.5 text-slate-400 hover:text-white text-[10px] font-bold uppercase tracking-widest transition-all">Payouts</a>
						<a href="/dashboard/calculators" class="flex items-center gap-3 px-4 py-2.5 text-slate-400 hover:text-white text-[10px] font-bold uppercase tracking-widest transition-all">Calculators</a>
					</nav>
				</div>
			</div>
		</aside>

		<div class="flex-1 ml-64 p-12">
			<header class="flex justify-between items-end mb-16">
				<div>
					<h1 class="text-4xl font-[900] text-slate-950 uppercase tracking-tighter leading-none">RENTERS</h1>
					<p class="text-slate-400 text-[10px] font-black uppercase tracking-[0.3em] mt-3">Portfolio Partner Management</p>
				</div>
				<div class="bg-white border border-slate-200 px-6 py-3 rounded-2xl flex items-center gap-3 shadow-sm">
					<span class="text-[9px] font-black uppercase text-slate-400">Monthly Rent Roll</span>
					<b class="text-sm text-slate-950">$6,250.00/mo</b>
				</div>
			</header>

			<!-- Institutional Renter Grid -->
			<div class="bg-white border border-slate-200 rounded-[40px] shadow-sm overflow-hidden">
				<table class="w-full text-left text-sm">
					<thead>
						<tr class="bg-slate-50 text-[10px] uppercase font-black tracking-widest text-slate-400 border-b border-slate-100">
							<th class="px-8 py-5">Partner Entity</th>
							<th class="px-8 py-5">Territories Control</th>
							<th class="px-8 py-5">Lease Status</th>
							<th class="px-8 py-5 text-right">Portfolio Rent</th>
							<th class="px-8 py-5 text-right">Leads</th>
							<th class="px-8 py-5 text-right">Action</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-50">
						{renters.map(r => (
							<tr class="hover:bg-slate-50/50 transition-colors group">
								<td class="px-8 py-6">
									<b class="text-slate-950 block uppercase tracking-tight">{r.businessName}</b>
									<span class="text-[10px] text-slate-400 font-bold uppercase">MD Operator: {r.owner}</span>
								</td>
								<td class="px-8 py-6">
									<div class="space-y-1">
										<b class="text-xs text-slate-900">{r.assetsLeased} Assets</b>
										<div class="flex flex-wrap gap-2">
											{r.territories.map(t => <span class="text-[8px] bg-slate-100 text-slate-500 px-1.5 py-0.5 rounded font-black uppercase">{t}</span>)}
										</div>
									</div>
								</td>
								<td class="px-8 py-6">
									<span class={`text-[9px] font-black uppercase tracking-widest px-3 py-1 rounded-lg ${r.status === 'Current' ? 'bg-emerald-50 text-emerald-600' : 'bg-amber-50 text-amber-600'}`}>
										{r.status}
									</span>
								</td>
								<td class="px-8 py-6 text-right font-black text-slate-950 font-mono">${r.monthlyRent.toLocaleString()}</td>
								<td class="px-8 py-6 text-right">
									<div class="text-xs font-bold text-slate-950">{r.leadsDelivered} <small class="text-slate-400 font-medium ml-1">({r.convRate})</small></div>
								</td>
								<td class="px-8 py-6 text-right">
									<button class="text-blue-600 hover:text-blue-800 font-black text-[10px] uppercase tracking-widest">Partner Portal &rarr;</button>
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</div>
	</main>
</Layout>
