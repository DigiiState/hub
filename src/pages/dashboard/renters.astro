---
import Layout from '../../layouts/Layout.astro';

const renters = [
	{ name: "Young Septic Services", contact: "Mike Young", phone: "(410) 555-0122", territories: 2, status: "Active", rent: "$625.00/wk" },
	{ name: "Prestige Tree Experts", contact: "Sarah Miller", phone: "(443) 555-9877", territories: 1, status: "Trial", rent: "$0.00/wk" },
	{ name: "Portner & Shure", contact: "Firm Manager", phone: "(410) 555-7788", territories: 1, status: "Active", rent: "$625.00/wk" },
];
---

<Layout title="Renter Management | DigiiState OS">
	<main class="min-h-screen bg-slate-50 flex">
		<aside class="w-64 bg-slate-950 text-white flex flex-col p-6 fixed h-full">
			<div class="text-xl font-black tracking-tighter italic mb-12">Digii<span class="text-blue-500">State</span></div>
			<nav class="flex-1 space-y-1">
				<a href="/dashboard" class="flex items-center gap-3 px-4 py-3 text-slate-400 hover:text-white text-xs font-bold uppercase tracking-widest transition-colors"><span>📊</span> Dashboard</a>
				<a href="/dashboard/territories" class="flex items-center gap-3 px-4 py-3 text-slate-400 hover:text-white text-xs font-bold uppercase tracking-widest transition-colors"><span>🗺️</span> Territories</a>
				<a href="/dashboard/leads" class="flex items-center gap-3 px-4 py-3 text-slate-400 hover:text-white text-xs font-bold uppercase tracking-widest transition-colors"><span>📞</span> Lead Ledger</a>
				<a href="/dashboard/payouts" class="flex items-center gap-3 px-4 py-3 text-slate-400 hover:text-white text-xs font-bold uppercase tracking-widest transition-colors"><span>💰</span> Payouts</a>
				<a href="/dashboard/renewals" class="flex items-center gap-3 px-4 py-3 text-slate-400 hover:text-white text-xs font-bold uppercase tracking-widest transition-colors"><span>⏳</span> Renewals</a>
				<a href="/dashboard/settings" class="flex items-center gap-3 px-4 py-3 text-slate-400 hover:text-white text-xs font-bold uppercase tracking-widest transition-colors"><span>⚙️</span> Settings</a>
			</nav>
		</aside>

		<div class="flex-1 ml-64 p-10">
			<h1 class="text-3xl font-black text-slate-950 uppercase tracking-tight mb-12">Renter Management</h1>
			
			<div class="bg-white border border-slate-200 rounded-[40px] shadow-sm overflow-hidden">
				<table class="w-full text-left text-sm">
					<thead>
						<tr class="bg-slate-50 text-[10px] uppercase font-black tracking-widest text-slate-400 border-b border-slate-100">
							<th class="px-8 py-4">Partner Entity</th>
							<th class="px-8 py-4">Territories</th>
							<th class="px-8 py-4">Weekly Rent</th>
							<th class="px-8 py-4">Status</th>
							<th class="px-8 py-4 text-right">Action</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-50">
						{renters.map(renter => (
							<tr class="hover:bg-slate-50 transition-colors group">
								<td class="px-8 py-6">
									<div class="font-bold text-slate-950">{renter.name}</div>
									<div class="text-[10px] text-slate-400 font-bold uppercase">{renter.contact} • {renter.phone}</div>
								</td>
								<td class="px-8 py-6 font-bold text-slate-600">{renter.territories} Active</td>
								<td class="px-8 py-6 font-black text-emerald-600 font-mono">{renter.rent}</td>
								<td class="px-8 py-6">
									<span class={`text-[9px] font-black uppercase tracking-widest px-2 py-1 rounded-lg ${renter.status === 'Active' ? 'bg-emerald-50 text-emerald-600' : 'bg-amber-50 text-amber-600'}`}>
										{renter.status}
									</span>
								</td>
								<td class="px-8 py-6 text-right">
									<button class="text-blue-600 hover:text-blue-800 font-black text-[10px] uppercase tracking-widest">Portal &rarr;</button>
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</div>
	</main>
</Layout>
