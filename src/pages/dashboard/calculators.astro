---
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../../components/Sidebar.astro';
import { getPortfolioStats } from '../../lib/db';

const portfolioStats = await getPortfolioStats();
---

<Layout title="Strategic Calculators | DigiiState OS">
	<main class="min-h-screen bg-slate-50 flex">
		<Sidebar activePath="/dashboard/calculators" />

		<div class="flex-1 ml-64 p-12">
			<header class="flex justify-between items-end mb-16">
				<div>
					<h1 class="text-4xl font-[900] text-slate-950 uppercase tracking-tighter leading-none">CALCULATORS</h1>
					<p class="text-slate-400 text-[10px] font-black uppercase tracking-[0.3em] mt-3">Strategic Modeling & Yield Projections</p>
				</div>
			</header>

			<div class="grid lg:grid-cols-2 gap-12">
				<!-- 1. The Monopoly Rent Calculator -->
				<div class="bg-slate-950 text-white rounded-[48px] p-12 shadow-2xl relative overflow-hidden">
					<div class="absolute top-0 right-0 w-64 h-64 bg-blue-600/10 rounded-full blur-3xl translate-x-32 -translate-y-32"></div>
					<div class="relative z-10">
						<div class="flex items-center justify-between mb-12">
							<h3 class="text-xs font-black uppercase tracking-[0.4em] text-blue-500 italic">Monopoly Yield</h3>
							<span class="px-3 py-1 bg-blue-500/10 text-blue-400 text-[10px] font-black rounded-full uppercase tracking-widest border border-blue-500/20">Active Model</span>
						</div>

						<div class="space-y-10">
							<div class="space-y-4">
								<div class="flex justify-between text-[10px] font-black uppercase text-slate-500 tracking-widest">
									<span>Avg. Ticket Value</span>
									<span id="label-ticket" class="text-white">$2,800</span>
								</div>
								<input type="range" id="input-ticket" min="500" max="15000" step="100" value="2800" class="w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-blue-500" />
							</div>

							<div class="space-y-4">
								<div class="flex justify-between text-[10px] font-black uppercase text-slate-500 tracking-widest">
									<span>Closing Rate</span>
									<span id="label-close" class="text-white">25%</span>
								</div>
								<input type="range" id="input-close" min="5" max="100" step="1" value="25" class="w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-blue-500" />
							</div>

							<div class="space-y-4">
								<div class="flex justify-between text-[10px] font-black uppercase text-slate-500 tracking-widest">
									<span>Monthly Leads</span>
									<span id="label-leads" class="text-white">20</span>
								</div>
								<input type="range" id="input-leads" min="1" max="100" step="1" value="20" class="w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-blue-500" />
							</div>
						</div>

						<div class="mt-16 pt-12 border-t border-white/5">
							<div class="text-[10px] font-black text-slate-500 uppercase tracking-widest mb-4">Est. Market Value / Lead</div>
							<div id="result-market" class="text-4xl font-black text-white mb-6">$840.00</div>
							<div class="pt-6 border-t border-white/5">
								<div class="text-[10px] font-black text-amber-500 uppercase tracking-widest mb-1">DigiiState Monopoly Lease</div>
								<div class="text-2xl font-black text-white">${(portfolioStats.monthlyRentRoll / portfolioStats.leasedAssets).toLocaleString()}</div>
							</div>
						</div>
					</div>
				</div>

				<!-- 2. The 90% Success Path (Empire Scaling) -->
				<div class="bg-white border border-slate-200 rounded-[40px] shadow-sm p-10">
					<div class="flex items-center justify-between mb-8">
						<h3 class="text-xs font-black uppercase tracking-widest text-slate-400">The 90% Success Path</h3>
						<span class="px-3 py-1 bg-emerald-50 text-emerald-600 text-[10px] font-black rounded-full uppercase tracking-widest">Empire Growth</span>
					</div>

					<div class="space-y-8">
						<div class="space-y-4">
							<div class="flex justify-between text-[10px] font-black uppercase text-slate-500 tracking-widest">
								<span>Total Assets Managed</span>
								<span id="label-assets" class="text-emerald-600">{portfolioStats.totalAssets}</span>
							</div>
							<input type="range" id="input-assets" min="1" max="150" value={portfolioStats.totalAssets} class="w-full h-2 bg-slate-100 rounded-lg appearance-none cursor-pointer accent-emerald-500" />
						</div>

						<div class="space-y-4">
							<div class="flex justify-between text-[10px] font-black uppercase text-slate-500 tracking-widest">
								<span>Target Lease / Asset</span>
								<span id="label-rent" class="text-emerald-600">$1,250</span>
							</div>
							<input type="range" id="input-rent" min="500" max="5000" step="50" value="1250" class="w-full h-2 bg-slate-100 rounded-lg appearance-none cursor-pointer accent-emerald-500" />
						</div>

						<div class="space-y-4">
							<div class="flex justify-between text-[10px] font-black uppercase text-slate-500 tracking-widest">
								<span>OpEx / Asset</span>
								<span id="label-opex" class="text-red-500">$50</span>
							</div>
							<input type="range" id="input-opex" min="10" max="500" step="5" value="50" class="w-full h-2 bg-slate-100 rounded-lg appearance-none cursor-pointer accent-red-500" />
						</div>

						<div class="mt-12 p-8 bg-slate-50 rounded-3xl border border-slate-100">
							<div class="grid grid-cols-2 gap-8 text-center">
								<div>
									<span class="text-[9px] font-black text-slate-400 uppercase block mb-2">Monthly NOI</span>
									<b id="result-noi" class="text-2xl text-slate-950 font-black">$24,000</b>
								</div>
								<div>
									<span class="text-[9px] font-black text-slate-400 uppercase block mb-2">Portfolio Value</span>
									<b id="result-val" class="text-2xl text-blue-600 font-black">$240k</b>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</main>
</Layout>

<script>
	// Reactive Logic for Calculators
	const inputs = {
		ticket: document.getElementById('input-ticket'),
		close: document.getElementById('input-close'),
		leads: document.getElementById('input-leads'),
		assets: document.getElementById('input-assets'),
		rent: document.getElementById('input-rent'),
		opex: document.getElementById('input-opex')
	};

	const labels = {
		ticket: document.getElementById('label-ticket'),
		close: document.getElementById('label-close'),
		leads: document.getElementById('label-leads'),
		assets: document.getElementById('label-assets'),
		rent: document.getElementById('label-rent'),
		opex: document.getElementById('label-opex')
	};

	const results = {
		market: document.getElementById('result-market'),
		noi: document.getElementById('result-noi'),
		val: document.getElementById('result-val')
	};

	function update() {
		// Monopoly Model
		labels.ticket.innerText = `$${Number(inputs.ticket.value).toLocaleString()}`;
		labels.close.innerText = `${inputs.close.value}%`;
		labels.leads.innerText = inputs.leads.value;

		const revenuePerLead = (inputs.ticket.value * (inputs.close.value / 100));
		results.market.innerText = `$${revenuePerLead.toFixed(2)}`;

		// Empire Model
		labels.assets.innerText = inputs.assets.value;
		labels.rent.innerText = `$${Number(inputs.rent.value).toLocaleString()}`;
		labels.opex.innerText = `$${inputs.opex.value}`;

		const monthlyNOI = (inputs.rent.value - inputs.opex.value) * inputs.assets.value;
		results.noi.innerText = `$${monthlyNOI.toLocaleString()}`;
		results.val.innerText = `$${(monthlyNOI * 12 * 0.1).toFixed(0)}k`; // 10% Yield Valuation
	}

	Object.values(inputs).forEach(input => input?.addEventListener('input', update));
</script>
