---
import Layout from '../../layouts/Layout.astro';

// Calculate pay based on the 60/30/10 split logic
const weeklyRevenue = 1875.00; // Mock current weekly revenue
const founderPay = weeklyRevenue * 0.60;
const taxReserve = weeklyRevenue * 0.30;
const growthOps = weeklyRevenue * 0.10;

const payoutHistory = [
	{ date: "Aug 10, 2026", amount: "$1,125.00", status: "Transferred", method: "Owner's Draw" },
	{ date: "Aug 03, 2026", amount: "$1,050.00", status: "Transferred", method: "Owner's Draw" },
];
---

<Layout title="Founder Payouts | DigiiState OS">
	<main class="min-h-screen bg-slate-50 flex">
		<aside class="w-64 bg-slate-950 text-white flex flex-col p-6 fixed h-full shadow-2xl overflow-y-auto">
			<div class="text-2xl font-black tracking-tighter italic mb-12">Digii<span class="text-blue-500">State</span></div>
			<div class="space-y-8">
				<div>
					<h3 class="text-[10px] font-black text-slate-500 uppercase tracking-widest mb-4">Operations</h3>
					<nav class="space-y-1">
						<a href="/dashboard" class="flex items-center gap-3 px-4 py-2.5 text-slate-400 hover:text-white text-[10px] font-bold uppercase tracking-widest transition-all" data-path="/dashboard">Command Center</a>
						<a href="/dashboard/portfolio" class="flex items-center gap-3 px-4 py-2.5 text-slate-400 hover:text-white text-[10px] font-bold uppercase tracking-widest transition-all" data-path="/dashboard/portfolio">Portfolio</a>
						<a href="/dashboard/territories" class="flex items-center gap-3 px-4 py-2.5 text-slate-400 hover:text-white text-[10px] font-bold uppercase tracking-widest transition-all" data-path="/dashboard/territories">Territories</a>
						<a href="/dashboard/vault" class="flex items-center gap-3 px-4 py-2.5 text-slate-400 hover:text-white text-[10px] font-bold uppercase tracking-widest transition-all" data-path="/dashboard/vault">Digital Vault</a>
						<a href="/dashboard/leads" class="flex items-center gap-3 px-4 py-2.5 text-slate-400 hover:text-white text-[10px] font-bold uppercase tracking-widest transition-all" data-path="/dashboard/leads">Lead Ledger</a>
						<a href="/dashboard/renters" class="flex items-center gap-3 px-4 py-2.5 text-slate-400 hover:text-white text-[10px] font-bold uppercase tracking-widest transition-all" data-path="/dashboard/renters">Renters</a>
					</nav>
				</div>
				<div>
					<h3 class="text-[10px] font-black text-slate-500 uppercase tracking-widest mb-4">Growth</h3>
					<nav class="space-y-1">
						<a href="/dashboard/acquisitions" class="flex items-center gap-3 px-4 py-2.5 text-slate-400 hover:text-white text-[10px] font-bold uppercase tracking-widest transition-all" data-path="/dashboard/acquisitions">Acquisitions</a>
						<a href="/dashboard/intelligence" class="flex items-center gap-3 px-4 py-2.5 text-slate-400 hover:text-white text-[10px] font-bold uppercase tracking-widest transition-all" data-path="/dashboard/intelligence">Intelligence</a>
					</nav>
				</div>
				<div>
					<h3 class="text-[10px] font-black text-slate-500 uppercase tracking-widest mb-4">Finance</h3>
					<nav class="space-y-1">
						<a href="/dashboard/financials" class="flex items-center gap-3 px-4 py-2.5 text-slate-400 hover:text-white text-[10px] font-bold uppercase tracking-widest transition-all" data-path="/dashboard/financials">Financials</a>
						<a href="/dashboard/payouts" class="flex items-center gap-3 px-4 py-2.5 text-slate-400 hover:text-white text-[10px] font-bold uppercase tracking-widest transition-all" data-path="/dashboard/payouts">Payouts</a>
						<a href="/dashboard/calculators" class="flex items-center gap-3 px-4 py-2.5 text-slate-400 hover:text-white text-[10px] font-bold uppercase tracking-widest transition-all" data-path="/dashboard/calculators">Calculators</a>
					</nav>
				</div>
				<div>
					<h3 class="text-[10px] font-black text-slate-500 uppercase tracking-widest mb-4">Infrastructure</h3>
					<nav class="space-y-1">
						<a href="/dashboard/infrastructure" class="flex items-center gap-3 px-4 py-2.5 text-slate-400 hover:text-white text-[10px] font-bold uppercase tracking-widest transition-all" data-path="/dashboard/infrastructure">Infrastructure</a>
						<a href="/dashboard/alerts" class="flex items-center gap-3 px-4 py-2.5 text-slate-400 hover:text-white text-[10px] font-bold uppercase tracking-widest transition-all" data-path="/dashboard/alerts">Alerts</a>
					</nav>
				</div>
				<div class="pt-8 border-t border-white/10 mt-auto">
					<a href="/dashboard/settings" class="flex items-center gap-3 px-4 py-2.5 text-slate-400 hover:text-white text-[10px] font-bold uppercase tracking-widest transition-all" data-path="/dashboard/settings">Settings</a>
				</div>
			</div>
		</aside>

		<div class="flex-1 ml-64 p-10">
			<header class="flex justify-between items-end mb-12">
				<div>
					<h1 class="text-3xl font-black text-slate-950 uppercase tracking-tight">Founder Payouts</h1>
					<p class="text-slate-400 text-sm font-medium">Safe Withdrawal Allocation (60/30/10 Protocol)</p>
				</div>
				<button class="bg-blue-600 text-white px-8 py-4 rounded-xl text-[10px] font-black uppercase tracking-widest hover:bg-blue-700 transition-all shadow-xl shadow-blue-600/20">
					Initiate Draw
				</button>
			</header>

			<!-- Allocation Grid -->
			<div class="grid grid-cols-3 gap-6 mb-12">
				<div class="bg-white p-8 rounded-[40px] border border-slate-200 shadow-sm border-t-[6px] border-t-emerald-500">
					<span class="text-[10px] font-black text-slate-400 uppercase tracking-widest block mb-4">Available to Withdraw (60%)</span>
					<div class="text-4xl font-black text-slate-950">${founderPay.toLocaleString(undefined, {minimumFractionDigits: 2})}</div>
					<p class="text-[10px] text-slate-400 mt-4 uppercase font-bold tracking-tighter italic">Personal "Founders Pay" Envelope</p>
				</div>
				<div class="bg-white p-8 rounded-[40px] border border-slate-200 shadow-sm border-t-[6px] border-t-red-500">
					<span class="text-[10px] font-black text-slate-400 uppercase tracking-widest block mb-4">Tax Reserve (30%)</span>
					<div class="text-4xl font-black text-slate-950">${taxReserve.toLocaleString(undefined, {minimumFractionDigits: 2})}</div>
					<p class="text-[10px] text-slate-400 mt-4 uppercase font-bold tracking-tighter italic">Held for MD/Federal Obligations</p>
				</div>
				<div class="bg-white p-8 rounded-[40px] border border-slate-200 shadow-sm border-t-[6px] border-t-blue-500">
					<span class="text-[10px] font-black text-slate-400 uppercase tracking-widest block mb-4">Ops & Growth (10%)</span>
					<div class="text-4xl font-black text-slate-950">${growthOps.toLocaleString(undefined, {minimumFractionDigits: 2})}</div>
					<p class="text-[10px] text-slate-400 mt-4 uppercase font-bold tracking-tighter italic">Reinvestment in New Territories</p>
				</div>
			</div>

			<!-- History -->
			<div class="bg-white border border-slate-200 rounded-[40px] shadow-sm overflow-hidden">
				<div class="px-8 py-6 border-b border-slate-100 flex justify-between items-center">
					<h3 class="text-xs font-black uppercase tracking-widest text-slate-950">Payout History</h3>
				</div>
				<table class="w-full text-left text-sm">
					<thead>
						<tr class="bg-slate-50 text-[10px] uppercase font-black tracking-widest text-slate-400 border-b border-slate-100">
							<th class="px-8 py-4">Date</th>
							<th class="px-8 py-4">Amount</th>
							<th class="px-8 py-4">Method</th>
							<th class="px-8 py-4 text-right">Status</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-50">
						{payoutHistory.map(p => (
							<tr class="hover:bg-slate-50 transition-colors">
								<td class="px-8 py-6 font-bold text-slate-950">{p.date}</td>
								<td class="px-8 py-6 font-black text-slate-950 font-mono text-lg">{p.amount}</td>
								<td class="px-8 py-6 text-xs text-slate-500 font-bold uppercase tracking-widest">{p.method}</td>
								<td class="px-8 py-6 text-right">
									<span class="px-3 py-1 bg-emerald-50 text-emerald-600 text-[10px] font-black rounded-full uppercase tracking-widest">
										{p.status}
									</span>
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</div>
	</main>
</Layout>
