---
import Layout from '../layouts/Layout.astro';

// PHASE 4: TERRITORY ACQUISITION ENGINE
// Underwriting logic and market analysis tool

const industries = ["Septic", "Tree Removal", "Water Damage", "Roofing", "DUI Law", "HVAC", "Junk Removal"];
const states = ["MD", "TX", "FL", "WA", "IL", "CA", "NY"];

const recentUnderwriting = [
	{ city: "Columbia", state: "MD", niche: "Septic", score: 91, verdict: "BUY", capReq: "$1,250", estLease: "$1,250" },
	{ city: "Austin", state: "TX", niche: "Roofing", score: 84, verdict: "BUY", capReq: "$2,500", estLease: "$2,500" },
	{ city: "Miami", state: "FL", niche: "Junk", score: 42, verdict: "PASS", capReq: "$800", estLease: "$500" },
];
---

<Layout title="Acquisitions Engine | DigiiState OS">
	<main class="min-h-screen bg-slate-50 flex">
		<!-- Standardized Sidebar (Updated) -->
		<aside class="w-64 bg-slate-950 text-white flex flex-col p-6 fixed h-full shadow-2xl">
			<div class="text-2xl font-black tracking-tighter italic mb-12">Digii<span class="text-blue-500">State</span></div>
			<div class="space-y-8">
				<div>
					<h3 class="text-[10px] font-black text-slate-500 uppercase tracking-widest mb-4">Operations</h3>
					<nav class="space-y-1">
						<a href="/dashboard" class="flex items-center gap-3 px-4 py-2.5 text-slate-400 hover:text-white text-[10px] font-bold uppercase tracking-widest transition-all">Command Center</a>
						<a href="/dashboard/territories" class="flex items-center gap-3 px-4 py-2.5 text-slate-400 hover:text-white text-[10px] font-bold uppercase tracking-widest transition-all">Portfolio</a>
						<a href="/dashboard/territories" class="flex items-center gap-3 px-4 py-2.5 text-slate-400 hover:text-white text-[10px] font-bold uppercase tracking-widest transition-all">Territories</a>
						<a href="/dashboard/vault" class="flex items-center gap-3 px-4 py-2.5 text-slate-400 hover:text-white text-[10px] font-bold uppercase tracking-widest transition-all">Digital Vault</a>
					</nav>
				</div>
				<div>
					<h3 class="text-[10px] font-black text-slate-500 uppercase tracking-widest mb-4">Growth</h3>
					<nav class="space-y-1">
						<a href="/dashboard/acquisitions" class="flex items-center gap-3 px-4 py-2.5 bg-blue-600 rounded-xl text-[10px] font-bold uppercase tracking-widest transition-all">Acquisitions</a>
						<a href="/dashboard/intelligence" class="flex items-center gap-3 px-4 py-2.5 text-slate-400 hover:text-white text-[10px] font-bold uppercase tracking-widest transition-all">Intelligence</a>
					</nav>
				</div>
			</div>
		</aside>

		<div class="flex-1 ml-64 p-12">
			<header class="flex justify-between items-end mb-16">
				<div>
					<h1 class="text-4xl font-[900] text-slate-950 uppercase tracking-tighter leading-none">ACQUISITIONS</h1>
					<p class="text-slate-400 text-[10px] font-black uppercase tracking-[0.3em] mt-3">Territory Underwriting & Investment Engine</p>
				</div>
				<button class="bg-blue-600 text-white px-8 py-4 rounded-xl text-[10px] font-black uppercase tracking-widest shadow-xl shadow-blue-600/20 active:scale-95 transition-all">
					New Underwriting +
				</button>
			</header>

			<div class="grid lg:grid-cols-3 gap-12">
				<!-- Underwriting Form -->
				<div class="lg:col-span-1 bg-white border border-slate-200 rounded-[48px] p-10 shadow-sm">
					<h3 class="text-xs font-black uppercase tracking-[0.4em] text-slate-400 mb-10">Market Underwriting</h3>
					<form class="space-y-8">
						<div>
							<label class="block text-[9px] font-black uppercase text-slate-500 mb-2 tracking-widest">Industry Vertical</label>
							<select class="w-full bg-slate-50 border-b border-slate-200 py-3 text-sm font-bold outline-none focus:border-blue-600 transition-all">
								{industries.map(i => <option>{i}</option>)}
							</select>
						</div>
						<div class="grid grid-cols-2 gap-6">
							<div>
								<label class="block text-[9px] font-black uppercase text-slate-500 mb-2 tracking-widest">City</label>
								<input type="text" class="w-full bg-slate-50 border-b border-slate-200 py-3 text-sm font-bold outline-none focus:border-blue-600 transition-all" placeholder="e.g. Columbia" />
							</div>
							<div>
								<label class="block text-[9px] font-black uppercase text-slate-500 mb-2 tracking-widest">State</label>
								<select class="w-full bg-slate-50 border-b border-slate-200 py-3 text-sm font-bold outline-none focus:border-blue-600 transition-all">
									{states.map(s => <option>{s}</option>)}
								</select>
							</div>
						</div>
						<div>
							<label class="block text-[9px] font-black uppercase text-slate-500 mb-2 tracking-widest">Monthly Search Vol.</label>
							<input type="number" class="w-full bg-slate-50 border-b border-slate-200 py-3 text-sm font-bold outline-none focus:border-blue-600 transition-all" placeholder="500" />
						</div>
						<div class="bg-blue-50/50 p-6 rounded-3xl border border-blue-100">
							<div class="flex justify-between items-center">
								<span class="text-[10px] font-black uppercase text-blue-600">Calculated Score</span>
								<b class="text-2xl font-black text-blue-700">--</b>
							</div>
							<p class="text-[9px] text-blue-500 uppercase font-bold mt-2 tracking-tighter">Enter data to generate BUY/PASS verdict.</p>
						</div>
					</form>
				</div>

				<!-- Recent Analyses -->
				<div class="lg:col-span-2 space-y-8">
					<h3 class="text-xs font-black uppercase tracking-[0.4em] text-slate-400">Underwriting History</h3>
					{recentUnderwriting.map(u => (
						<div class="bg-white border border-slate-200 rounded-[32px] p-8 flex justify-between items-center shadow-sm hover:border-blue-300 transition-all group">
							<div class="flex items-center gap-6">
								<div class={`w-16 h-16 rounded-2xl flex items-center justify-center font-black text-lg ${u.score >= 80 ? 'bg-emerald-50 text-emerald-600' : 'bg-red-50 text-red-600'}`}>
									{u.score}
								</div>
								<div>
									<b class="text-lg text-slate-950 uppercase tracking-tighter">{u.city}, {u.state}</b>
									<div class="flex items-center gap-3 mt-1">
										<span class="text-[10px] text-slate-400 font-black uppercase tracking-widest">{u.niche}</span>
										<span class="w-1.5 h-1.5 rounded-full bg-slate-200"></span>
										<span class="text-[9px] font-black text-blue-600 uppercase tracking-widest">Est. Lease: {u.estLease}</span>
									</div>
								</div>
							</div>
							<div class="text-right">
								<div class={`text-[10px] font-black uppercase px-4 py-1.5 rounded-full border mb-2 ${u.verdict === 'BUY' ? 'bg-emerald-50 border-emerald-100 text-emerald-600' : 'bg-red-50 border-red-100 text-red-600'}`}>
									{u.verdict}
								</div>
								<span class="text-[9px] font-bold text-slate-400 uppercase tracking-widest">Cap Req: {u.capReq}</span>
							</div>
						</div>
					))}
				</div>
			</div>
		</div>
	</main>
</Layout>
