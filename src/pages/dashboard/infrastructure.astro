---
import Layout from '../../layouts/Layout.astro';

// PHASE 8: NATIONAL INFRASTRUCTURE DATA
const infrastructure = [
	{ provider: "Cloudflare", service: "Enterprise Network", cost: "$125.00/mo", next: "Aug 15, 2027", status: "Healthy" },
	{ provider: "Twilio", service: "Number Provisioning", cost: "Consumption", next: "N/A", status: "Healthy" },
	{ provider: "Vapi.ai", service: "Voice AI Receptionist", cost: "$99.00/mo", next: "Aug 20, 2026", status: "Healthy" },
	{ provider: "Make.com", service: "Workflow Triage", cost: "$10.50/mo", next: "Sept 14, 2026", status: "Healthy" },
	{ provider: "Serper.dev", service: "SERP Monitoring", cost: "$50.00/mo", next: "Sept 1, 2026", status: "Healthy" },
];
---

<Layout title="Infrastructure Ledger | DigiiState OS">
	<main class="min-h-screen bg-slate-50 flex">
		<!-- Standard Sidebar -->
		<aside class="w-64 bg-slate-950 text-white flex flex-col p-6 fixed h-full shadow-2xl overflow-y-auto">
			<div class="text-2xl font-black tracking-tighter italic mb-12 text-center">Digii<span class="text-blue-500">State</span></div>
			<div class="space-y-8">
				<div>
					<h3 class="text-[10px] font-black text-slate-500 uppercase tracking-widest mb-4">Operations</h3>
					<nav class="space-y-1">
						<a href="/dashboard" class="flex items-center gap-3 px-4 py-2.5 text-slate-400 hover:text-white text-[10px] font-bold uppercase tracking-widest transition-all">Command Center</a>
						<a href="/dashboard/portfolio" class="flex items-center gap-3 px-4 py-2.5 text-slate-400 hover:text-white text-[10px] font-bold uppercase tracking-widest transition-all">Portfolio</a>
					</nav>
				</div>
                <div>
					<h3 class="text-[10px] font-black text-slate-500 uppercase tracking-widest mb-4">Infrastructure</h3>
					<nav class="space-y-1">
						<a href="/dashboard/infrastructure" class="flex items-center gap-3 px-4 py-2.5 bg-blue-600 rounded-xl text-[10px] font-bold uppercase tracking-widest transition-all">Infrastructure</a>
						<a href="/dashboard/alerts" class="flex items-center gap-3 px-4 py-2.5 text-slate-400 hover:text-white text-[10px] font-bold uppercase tracking-widest transition-all">Alerts</a>
					</nav>
				</div>
			</div>
		</aside>

		<div class="flex-1 ml-64 p-12">
			<header class="flex justify-between items-end mb-16">
				<div>
					<h1 class="text-4xl font-[900] text-slate-950 uppercase tracking-tighter leading-none">INFRASTRUCTURE</h1>
					<p class="text-slate-400 text-[10px] font-black uppercase tracking-[0.3em] mt-3">Vendor Management & Enterprise Tooling</p>
				</div>
				<div class="bg-white border border-slate-200 px-6 py-3 rounded-2xl flex items-center gap-3 shadow-sm">
					<span class="text-[9px] font-black uppercase text-slate-400">Total Opex</span>
					<b class="text-sm text-slate-950">$284.50/mo</b>
				</div>
			</header>

			<!-- Vendor Table -->
			<div class="bg-white border border-slate-200 rounded-[40px] shadow-sm overflow-hidden mb-12">
				<table class="w-full text-left text-sm">
					<thead>
						<tr class="bg-slate-50 text-[9px] font-black uppercase tracking-widest text-slate-400 border-b border-slate-100">
							<th class="px-8 py-5">Service Provider</th>
							<th class="px-8 py-5">Core Capability</th>
							<th class="px-8 py-5 text-right">Monthly Cost</th>
							<th class="px-8 py-5">Status</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-50">
						{infrastructure.map(i => (
							<tr class="hover:bg-slate-50/50 transition-colors">
								<td class="px-8 py-6">
									<b class="text-slate-950 block uppercase tracking-tight">{i.provider}</b>
								</td>
								<td class="px-8 py-6 text-xs text-slate-500 font-bold uppercase">
									{i.service}
								</td>
								<td class="px-8 py-6 text-right font-black text-slate-950 font-mono">
									{i.cost}
								</td>
								<td class="px-8 py-6">
									<div class="flex items-center gap-2">
										<span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
										<span class="text-[10px] font-black uppercase text-slate-600">{i.status}</span>
									</div>
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>

			<!-- COST ALLOCATION LOGIC (Phase 8) -->
			<div class="bg-slate-950 text-white p-12 rounded-[48px] shadow-2xl relative overflow-hidden">
				<div class="absolute top-0 right-0 w-48 h-48 bg-blue-600/10 rounded-full blur-[80px]"></div>
				<h3 class="text-xs font-black uppercase tracking-[0.4em] text-blue-500 mb-8 italic">Asset Cost Allocation</h3>
				<p class="text-slate-400 text-sm leading-relaxed mb-8 max-w-2xl">OpEx is automatically allocated to individual Digital Properties based on traffic share, lead volume, and API processing load. This ensures accurate NOI reporting at the asset level.</p>
				<button class="bg-white text-slate-950 px-8 py-4 rounded-xl font-black text-[10px] uppercase tracking-widest shadow-xl active:scale-95 transition-all">Audit Allocation Engine</button>
			</div>
		</div>
	</main>
</Layout>
