---
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../../components/Sidebar.astro';
import { 
    getAutopilotConfigs, 
    getAutonomousRuns, 
    getDeadLetterQueue, 
    getPendingApprovals, 
    getEngineeringTickets,
    getPortfolioStats 
} from '../../lib/db';

const configs = await getAutopilotConfigs();
const recentRuns = await getAutonomousRuns(10);
const deadLetter = await getDeadLetterQueue();
const approvals = await getPendingApprovals();
const tickets = await getEngineeringTickets();
const stats = await getPortfolioStats();

const globalConfig = configs.find(c => c.id === 'global');
const granularConfigs = configs.filter(c => c.id !== 'global');

// Derived status
const getHealthColor = (health: string) => {
    switch(health) {
        case 'HEALTHY': return 'text-emerald-500';
        case 'DEGRADED': return 'text-amber-500';
        case 'FAILED': return 'text-red-500';
        default: return 'text-slate-400';
    }
};

const getStatusBadge = (status: string) => {
    switch(status) {
        case 'SUCCESS': return 'bg-emerald-500/10 text-emerald-500 border-emerald-500/20';
        case 'FAILED': return 'bg-red-500/10 text-red-500 border-red-500/20';
        case 'RUNNING': return 'bg-blue-500/10 text-blue-500 border-blue-500/20 animate-pulse';
        default: return 'bg-slate-500/10 text-slate-500 border-slate-500/20';
    }
};
---

<Layout title="Autopilot Control | DigiiState OS">
	<main class="min-h-screen bg-slate-50 flex">
		<Sidebar active="autopilot" />

		<div class="flex-1 ml-64 p-12">
			<!-- Header -->
			<header class="flex justify-between items-end mb-16">
				<div>
					<div class="flex items-center gap-4">
						<h1 class="text-4xl font-black text-slate-950 uppercase tracking-tighter leading-none">AUTOPILOT</h1>
						<span class={`px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest border ${globalConfig?.is_active ? 'bg-emerald-500 text-white border-emerald-600' : 'bg-slate-200 text-slate-500 border-slate-300'}`}>
							{globalConfig?.is_active ? 'ON' : 'PAUSED'}
						</span>
					</div>
					<p class="text-slate-400 text-[10px] font-black uppercase tracking-[0.3em] mt-3">Governance, Observability & Control</p>
				</div>

				<div class="flex gap-4">
					<div class="bg-white border border-slate-200 p-6 rounded-3xl flex gap-12 shadow-sm">
						<div>
							<span class="text-[9px] font-black text-slate-400 uppercase block mb-1">Decisions</span>
							<b class="text-xl text-blue-600">{approvals.length}</b>
						</div>
						<div class="w-px h-8 bg-slate-100"></div>
						<div>
							<span class="text-[9px] font-black text-slate-400 uppercase block mb-1">Exceptions</span>
							<b class="text-xl text-red-600">{deadLetter.length}</b>
						</div>
						<div class="w-px h-8 bg-slate-100"></div>
						<div>
							<span class="text-[9px] font-black text-slate-400 uppercase block mb-1">Tickets</span>
							<b class="text-xl text-slate-950">{tickets.filter(t => t.status === 'OPEN').length}</b>
						</div>
					</div>
				</div>
			</header>

			<!-- Kill Switches & Health -->
			<section class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-16">
				{granularConfigs.map(config => (
					<div class="bg-white border border-slate-200 p-6 rounded-[32px] shadow-sm hover:border-blue-200 transition-all">
						<div class="flex justify-between items-start mb-4">
							<h3 class="text-[10px] font-black uppercase tracking-widest text-slate-400">{config.display_name}</h3>
							<div class={`w-2 h-2 rounded-full ${getHealthColor(config.health)} animate-pulse`}></div>
						</div>
						<div class="flex justify-between items-center">
							<span class={`text-xs font-bold ${config.is_active ? 'text-slate-900' : 'text-slate-400'}`}>
								{config.is_active ? 'ACTIVE' : 'DISABLED'}
							</span>
							<button class={`w-10 h-5 rounded-full relative transition-all ${config.is_active ? 'bg-blue-600' : 'bg-slate-200'}`}>
								<div class={`absolute top-1 w-3 h-3 bg-white rounded-full transition-all ${config.is_active ? 'right-1' : 'left-1'}`}></div>
							</button>
						</div>
					</div>
				))}
			</section>

			<div class="grid lg:grid-cols-3 gap-12">
				<!-- Run Ledger -->
				<div class="lg:col-span-2 space-y-12">
					<section>
						<div class="flex items-center justify-between mb-8">
							<h3 class="text-xs font-black uppercase tracking-[0.2em] text-slate-950 border-l-4 border-blue-600 pl-4">Autonomous Run Ledger</h3>
							<a href="#" class="text-[10px] font-black uppercase tracking-widest text-blue-600 hover:underline">View All Logs</a>
						</div>
						<div class="bg-white border border-slate-200 rounded-[32px] overflow-hidden shadow-sm">
							<table class="w-full text-left">
								<thead>
									<tr class="bg-slate-50 border-b border-slate-100">
										<th class="px-8 py-4 text-[10px] font-black uppercase tracking-widest text-slate-400">Agent / Loop</th>
										<th class="px-8 py-4 text-[10px] font-black uppercase tracking-widest text-slate-400">Action</th>
										<th class="px-8 py-4 text-[10px] font-black uppercase tracking-widest text-slate-400">Status</th>
										<th class="px-8 py-4 text-[10px] font-black uppercase tracking-widest text-slate-400 text-right">Time</th>
									</tr>
								</thead>
								<tbody class="divide-y divide-slate-50">
									{recentRuns.map(run => (
										<tr class="hover:bg-slate-50/50 transition-all group">
											<td class="px-8 py-5">
												<div class="text-sm font-bold text-slate-900">{run.agent_name}</div>
												<div class="text-[10px] text-slate-400 font-medium">{run.loop_name}</div>
											</td>
											<td class="px-8 py-5 text-sm text-slate-600 font-medium">
												{run.action_performed || '---'}
											</td>
											<td class="px-8 py-5">
												<span class={`px-2 py-1 rounded text-[9px] font-bold border ${getStatusBadge(run.status)}`}>
													{run.status}
												</span>
											</td>
											<td class="px-8 py-5 text-right text-[10px] text-slate-400 font-bold uppercase tracking-tighter">
												{new Date(run.started_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}
											</td>
										</tr>
									))}
									{recentRuns.length === 0 && (
										<tr>
											<td colspan="4" class="px-8 py-12 text-center text-slate-400 text-xs font-medium italic">No autonomous runs recorded in this window.</td>
										</tr>
									)}
								</tbody>
							</table>
						</div>
					</section>

					<!-- Dead Letter Queue -->
					<section>
						<div class="flex items-center gap-3 mb-8">
							<h3 class="text-xs font-black uppercase tracking-[0.2em] text-red-600 border-l-4 border-red-600 pl-4">Exception Queue</h3>
							<span class="bg-red-100 text-red-600 px-2 py-0.5 rounded-full text-[9px] font-black">{deadLetter.length} BLOCKED</span>
						</div>
						<div class="grid gap-4">
							{deadLetter.map(fail => (
								<div class="bg-white border border-red-100 rounded-3xl p-6 flex justify-between items-center shadow-sm hover:border-red-200 transition-all">
									<div class="flex items-center gap-6">
										<div class="w-10 h-10 rounded-2xl bg-red-50 flex items-center justify-center">
											<span class="text-red-500 font-black">!</span>
										</div>
										<div>
											<h4 class="text-sm font-bold text-slate-900">{fail.loop_name} Terminal Failure</h4>
											<p class="text-xs text-slate-500 mt-1 max-w-md">{fail.root_cause}</p>
										</div>
									</div>
									<div class="flex items-center gap-4 text-right">
										<div class="text-[10px] text-slate-400 font-black uppercase tracking-widest mb-1">Impact</div>
										<div class={`text-[10px] font-black uppercase tracking-widest ${fail.severity === 'CRITICAL' ? 'text-red-600' : 'text-amber-600'}`}>{fail.severity}</div>
									</div>
								</div>
							))}
						</div>
					</section>
				</div>

				<!-- Activity Feed & Sidebar -->
				<div class="space-y-12">
					<section>
						<h3 class="text-xs font-black uppercase tracking-[0.2em] text-slate-950 mb-8">Agent Activity</h3>
						<div class="space-y-8 relative before:absolute before:left-[11px] before:top-2 before:bottom-0 before:w-0.5 before:bg-slate-100">
							{recentRuns.filter(r => r.status === 'SUCCESS').slice(0, 5).map(run => (
								<div class="relative pl-10">
									<div class="absolute left-0 top-1 w-6 h-6 rounded-full bg-white border-2 border-slate-100 flex items-center justify-center z-10">
										<div class="w-1.5 h-1.5 rounded-full bg-emerald-500"></div>
									</div>
									<div class="text-sm font-bold text-slate-900">{run.agent_name}</div>
									<p class="text-xs text-slate-500 mt-1">{run.action_performed}</p>
									<div class="text-[9px] text-slate-400 font-black uppercase tracking-tighter mt-2">
										{run.assets?.domain} • {new Date(run.started_at).toLocaleTimeString()}
									</div>
								</div>
							))}
						</div>
					</section>

					<!-- Pending Decisions -->
					<section class="bg-slate-900 text-white p-8 rounded-[40px] shadow-2xl overflow-hidden relative">
						<div class="absolute -right-10 -top-10 w-40 h-40 bg-blue-600/10 rounded-full blur-3xl"></div>
						<h3 class="text-[10px] font-black uppercase tracking-[0.4em] text-blue-500 mb-8 italic">Governance Queue</h3>
						{approvals.length > 0 ? (
							<div class="space-y-6">
								{approvals.map(app => (
									<div class="p-5 bg-white/5 rounded-2xl border border-white/10 hover:bg-white/10 transition-all cursor-pointer">
										<div class="text-xs font-bold mb-2">{app.proposed_action}</div>
										<div class="flex justify-between items-center">
											<span class="text-[10px] text-slate-400 font-bold uppercase tracking-widest">{app.proposed_by}</span>
											<span class="text-[10px] text-emerald-400 font-black italic">Approve →</span>
										</div>
									</div>
								))}
							</div>
						) : (
							<div class="text-center py-8">
								<div class="text-slate-500 text-[10px] font-bold uppercase tracking-widest mb-2">System Autonomous</div>
								<div class="text-emerald-500 text-xs font-black">All loops active.</div>
							</div>
						)}
					</section>
				</div>
			</div>
		</div>
	</main>
</Layout>
