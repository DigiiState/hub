---
import Layout from '../layouts/Layout.astro';

// Mock Data for Pilot Phase
const portfolioStats = {
	totalRevenue: "$1,875.00",
	totalLeads: "142",
	occupancy: "15%",
	avgRanking: "#4.2"
};

const territories = [
	{ name: "Phoenix MD Septic", domain: "phoenixmdseptic.com", leads: 8, status: "Leased", rent: "$312.50", niche: "Septic", ranking: "#1" },
	{ name: "Clarksville Septic", domain: "clarksvillesepticpros.pages.dev", leads: 5, status: "Ranking", rent: "$312.50", niche: "Septic", ranking: "#8" },
	{ name: "Gibson Island Tree", domain: "gibson-island-tree-removal.pages.dev", leads: 3, status: "Ranking", rent: "$312.50", niche: "Tree", ranking: "#14" },
	{ name: "Annapolis Tree", domain: "annapolis-tree-pros.pages.dev", leads: 12, status: "Available", rent: "$312.50", niche: "Tree", ranking: "#22" },
	{ name: "Clarksville Water", domain: "clarksville-water-damage.pages.dev", leads: 4, status: "Ranking", rent: "$312.50", niche: "Water", ranking: "#11" },
	{ name: "Annapolis DUI Law", domain: "annapolis-dui-defense.pages.dev", leads: 2, status: "Available", rent: "$625.00", niche: "Law", ranking: "#45" },
];

const recentLeads = [
	{ id: "L-9021", site: "Phoenix Septic", type: "Emergency", time: "14m ago", phone: "(410) 555-0199", status: "Qualified" },
	{ id: "L-9020", site: "Dallas Roofing", type: "Routine", time: "1h ago", phone: "(214) 555-9821", status: "Unassigned" },
	{ id: "L-9019", site: "Annapolis Law", type: "Intake", time: "3h ago", phone: "(443) 555-0102", status: "Forwarded" },
];
---

<Layout title="Admin Dashboard | DigiiState OS">
	<main class="min-h-screen bg-slate-50 flex">
		<!-- Sidebar -->
		<aside class="w-64 bg-slate-950 text-white flex flex-col p-6 fixed h-full">
			<div class="text-xl font-black tracking-tighter italic mb-12">
				Digii<span class="text-blue-500">State</span>
			</div>
			
			<nav class="flex-1 space-y-1">
				<a href="/dashboard" class="flex items-center gap-3 px-4 py-3 bg-blue-600 rounded-xl text-xs font-bold uppercase tracking-widest">
					<span>📊</span> Dashboard
				</a>
				<a href="/dashboard/territories" class="flex items-center gap-3 px-4 py-3 text-slate-400 hover:text-white text-xs font-bold uppercase tracking-widest transition-colors">
					<span>🗺️</span> Territories
				</a>
				<a href="/dashboard/leads" class="flex items-center gap-3 px-4 py-3 text-slate-400 hover:text-white text-xs font-bold uppercase tracking-widest transition-colors">
					<span>📞</span> Lead Ledger
				</a>
				<a href="/dashboard/renters" class="flex items-center gap-3 px-4 py-3 text-slate-400 hover:text-white text-xs font-bold uppercase tracking-widest transition-colors">
					<span>💳</span> Renters
				</a>
				<a href="/dashboard/settings" class="flex items-center gap-3 px-4 py-3 text-slate-400 hover:text-white text-xs font-bold uppercase tracking-widest transition-colors">
					<span>⚙️</span> Settings
				</a>
			</nav>

			<div class="pt-8 border-t border-white/10 mt-auto">
				<div class="flex items-center gap-3 px-4 py-3 text-xs font-bold uppercase text-slate-500 tracking-widest">
					<div class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></div>
					System Online
				</div>
			</div>
		</aside>

		<!-- Main Content -->
		<div class="flex-1 ml-64 p-10">
			<!-- Header -->
			<header class="flex justify-between items-end mb-12">
				<div>
					<h1 class="text-3xl font-black text-slate-950 uppercase tracking-tight">Portfolio Overview</h1>
					<p class="text-slate-400 text-sm font-medium">Managing 20 US Territories</p>
				</div>
				<div class="flex gap-4">
					<button class="bg-white border border-slate-200 px-6 py-3 rounded-xl text-[10px] font-black uppercase tracking-widest text-slate-600 hover:bg-slate-50 transition-all shadow-sm">
						Download Report
					</button>
					<button class="bg-blue-600 text-white px-6 py-3 rounded-xl text-[10px] font-black uppercase tracking-widest hover:bg-blue-700 transition-all shadow-xl shadow-blue-600/20">
						Deploy New Asset
					</button>
				</div>
			</header>

			<!-- Stats Grid -->
			<div class="grid grid-cols-4 gap-6 mb-12">
				<div class="bg-white p-6 rounded-[32px] border border-slate-200 shadow-sm">
					<span class="text-[10px] font-black text-slate-400 uppercase tracking-widest block mb-4">Weekly Rent Roll</span>
					<div class="text-3xl font-black text-slate-950">{portfolioStats.totalRevenue}</div>
					<div class="text-[10px] font-bold text-emerald-500 mt-2 uppercase tracking-tighter">+12% vs last week</div>
				</div>
				<div class="bg-white p-6 rounded-[32px] border border-slate-200 shadow-sm">
					<span class="text-[10px] font-black text-slate-400 uppercase tracking-widest block mb-4">Total Leads (30D)</span>
					<div class="text-3xl font-black text-slate-950">{portfolioStats.totalLeads}</div>
					<div class="text-[10px] font-bold text-blue-500 mt-2 uppercase tracking-tighter">Avg $42.10 Cost/Lead</div>
				</div>
				<div class="bg-white p-6 rounded-[32px] border border-slate-200 shadow-sm">
					<span class="text-[10px] font-black text-slate-400 uppercase tracking-widest block mb-4">Market Occupancy</span>
					<div class="text-3xl font-black text-slate-950">{portfolioStats.occupancy}</div>
					<div class="text-[10px] font-bold text-amber-500 mt-2 uppercase tracking-tighter">3 Leased | 17 Available</div>
				</div>
				<div class="bg-white p-6 rounded-[32px] border border-slate-200 shadow-sm">
					<span class="text-[10px] font-black text-slate-400 uppercase tracking-widest block mb-4">Avg. Search Rank</span>
					<div class="text-3xl font-black text-slate-950">{portfolioStats.avgRanking}</div>
					<div class="text-[10px] font-bold text-emerald-500 mt-2 uppercase tracking-tighter">↑ 2 Spots Avg</div>
				</div>
			</div>

			<div class="grid lg:grid-cols-3 gap-8">
				<!-- Lead Ledger -->
				<div class="lg:col-span-2 bg-white border border-slate-200 rounded-[40px] shadow-sm overflow-hidden">
					<div class="px-8 py-6 border-b border-slate-100 flex justify-between items-center">
						<h3 class="text-xs font-black uppercase tracking-widest text-slate-950">Real-Time Lead Ledger</h3>
						<span class="px-3 py-1 bg-emerald-50 text-emerald-600 text-[10px] font-black rounded-full uppercase tracking-widest animate-pulse">Live</span>
					</div>
					<div class="overflow-x-auto">
						<table class="w-full text-left text-sm">
							<thead>
								<tr class="bg-slate-50 text-[10px] uppercase font-black tracking-widest text-slate-400 border-b border-slate-100">
									<th class="px-8 py-4">Lead ID</th>
									<th class="px-8 py-4">Territory</th>
									<th class="px-8 py-4">Type</th>
									<th class="px-8 py-4">Status</th>
									<th class="px-8 py-4 text-right">Action</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-slate-50">
								{recentLeads.map(lead => (
									<tr class="hover:bg-slate-50 transition-colors group">
										<td class="px-8 py-6 font-mono text-[11px] font-bold text-slate-400">{lead.id}</td>
										<td class="px-8 py-6">
											<div class="font-bold text-slate-950">{lead.site}</div>
											<div class="text-[10px] text-slate-400 font-bold uppercase">{lead.time}</div>
										</td>
										<td class="px-8 py-6">
											<span class={`text-[9px] font-black uppercase tracking-widest px-2 py-1 rounded-lg ${lead.type === 'Emergency' ? 'bg-red-50 text-red-600' : 'bg-blue-50 text-blue-600'}`}>
												{lead.type}
											</span>
										</td>
										<td class="px-8 py-6 font-bold text-xs text-slate-600">{lead.status}</td>
										<td class="px-8 py-6 text-right">
											<button class="text-blue-600 hover:text-blue-800 font-black text-[10px] uppercase tracking-widest opacity-0 group-hover:opacity-100 transition-opacity">View Record &rarr;</button>
										</td>
									</tr>
								))}
							</tbody>
						</table>
					</div>
				</div>

				<!-- Territory Summary -->
				<div class="bg-white border border-slate-200 rounded-[40px] shadow-sm p-8">
					<h3 class="text-xs font-black uppercase tracking-widest text-slate-950 mb-8">Active Territories</h3>
					<div class="space-y-6">
						{territories.map(t => (
							<div class="flex justify-between items-center group cursor-pointer">
								<div>
									<div class="font-bold text-sm text-slate-950 group-hover:text-blue-600 transition-colors">{t.name}</div>
									<div class="text-[10px] font-bold text-slate-400 uppercase tracking-tighter">{t.niche} • {t.leads} Leads</div>
								</div>
								<div class="flex flex-col items-end">
									<div class={`text-[9px] font-black uppercase px-2 py-1 rounded-lg ${t.status === 'Leased' ? 'bg-amber-50 text-amber-600' : 'bg-slate-100 text-slate-500'}`}>
										{t.status}
									</div>
									<div class="text-xs font-black text-emerald-500 mt-1">{t.ranking}</div>
								</div>
							</div>
						))}
					</div>
					<button class="w-full mt-10 border-2 border-dashed border-slate-200 text-slate-400 py-4 rounded-2xl text-[10px] font-black uppercase tracking-widest hover:border-blue-300 hover:text-blue-400 transition-all">
						+ Map New Territory
					</button>
				</div>
			</div>
		</div>
	</main>
</Layout>
