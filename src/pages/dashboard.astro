---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import { portfolioStats, assets, managementAttention } from '../lib/db';

// AUTHORITATIVE ASSET SYNC
const territories = assets.slice(0, 5).map(a => ({
    ...a,
    ranks: a.ranks,
    health: a.health
}));
---

<Layout title="Command Center | DigiiState OS">
	<main class="min-h-screen bg-slate-50 flex">
		<Sidebar activePath="/dashboard" />

		<div class="flex-1 ml-64 p-12">
			<!-- Command Center Header -->
			<header class="flex justify-between items-end mb-16">
				<div>
					<h1 class="text-4xl font-black text-slate-950 uppercase tracking-tighter leading-none">COMMAND CENTER</h1>
					<p class="text-slate-400 text-[10px] font-black uppercase tracking-[0.3em] mt-3">Executive Oversight & Portfolio Performance</p>
				</div>
				<div class="flex gap-4">
					<div class="bg-white border border-slate-200 p-6 rounded-3xl flex gap-12 shadow-sm">
						<div>
							<span class="text-[9px] font-black text-slate-400 uppercase block mb-1">Pipeline Value</span>
							<b class="text-xl text-blue-600">${portfolioStats.totalPipelineValue.toLocaleString()}</b>
						</div>
						<div class="w-px h-8 bg-slate-100"></div>
						<div>
							<span class="text-[9px] font-black text-slate-400 uppercase block mb-1">Portfolio Health</span>
							<b class="text-xl text-emerald-500">{portfolioStats.avgHealthScore}</b>
						</div>
						<div class="w-px h-8 bg-slate-100"></div>
						<div>
							<span class="text-[9px] font-black text-slate-400 uppercase block mb-1">Total Assets</span>
							<b class="text-xl text-slate-950">{portfolioStats.totalAssets}</b>
						</div>
					</div>
				</div>
			</header>

			<!-- 1. MANAGEMENT ATTENTION (Phase 1) -->
			<section class="mb-16">
				<div class="flex items-center gap-3 mb-8">
					<h3 class="text-xs font-black uppercase tracking-[0.2em] text-red-600 border-l-4 border-red-600 pl-4">Management Attention</h3>
					<span class="text-[9px] font-bold text-slate-400 uppercase tracking-widest">Action Required</span>
				</div>
				<div class="grid gap-4">
					{managementAttention.map(item => (
						<div class="bg-white border border-slate-200 rounded-2xl p-5 flex justify-between items-center shadow-sm hover:border-blue-200 transition-all group">
							<div class="flex items-center gap-4">
								<div class={`w-2.5 h-2.5 rounded-full ${item.type === 'critical' ? 'bg-red-500 animate-pulse' : item.type === 'warning' ? 'bg-amber-500' : 'bg-emerald-500'}`}></div>
								<span class="text-sm font-bold text-slate-800">{item.message}</span>
							</div>
							<a href={item.target} class="bg-slate-50 text-blue-600 px-4 py-2 rounded-lg font-black text-[10px] uppercase tracking-widest hover:bg-blue-600 hover:text-white transition-all">{item.action} &rarr;</a>
						</div>
					))}
				</div>
			</section>

			<!-- 2. PRIMARY EXECUTIVE METRICS (Phase 1) -->
			<div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-16">
				<div class="bg-white p-8 rounded-[40px] border border-slate-200 shadow-sm relative overflow-hidden">
					<div class="absolute top-0 right-0 w-24 h-24 bg-blue-50 rounded-full translate-x-12 -translate-y-12 blur-2xl"></div>
					<span class="text-[10px] font-black text-slate-400 uppercase tracking-widest block mb-4">Monthly Rent Roll</span>
					<div class="text-3xl font-black text-slate-950">${portfolioStats.monthlyRentRoll.toLocaleString()}</div>
					<div class={`text-[10px] font-bold mt-2 uppercase ${portfolioStats.monthlyRentRoll > portfolioStats.prevRentRoll ? 'text-emerald-500' : 'text-slate-400'}`}>
						{portfolioStats.monthlyRentRoll > portfolioStats.prevRentRoll ? `+${( (portfolioStats.monthlyRentRoll - portfolioStats.prevRentRoll) / portfolioStats.prevRentRoll * 100 ).toFixed(1)}%` : '0%'} vs prev 30d
					</div>
				</div>
				<div class="bg-white p-8 rounded-[40px] border border-slate-200 shadow-sm">
					<span class="text-[10px] font-black text-slate-400 uppercase tracking-widest block mb-4">Monthly NOI</span>
					<div class="text-3xl font-black text-slate-950">${portfolioStats.monthlyNOI.toLocaleString()}</div>
					<div class="text-[10px] font-bold text-slate-400 mt-2 uppercase tracking-tighter">98.4% Operating Margin</div>
				</div>
				<div class="bg-white p-8 rounded-[40px] border border-slate-200 shadow-sm">
					<span class="text-[10px] font-black text-slate-400 uppercase tracking-widest block mb-4">Annualized NOI</span>
					<div class="text-3xl font-black text-slate-950">${portfolioStats.annualizedNOI.toLocaleString()}</div>
					<div class="text-[10px] font-bold text-blue-500 mt-2 uppercase tracking-tighter">Projected Yield</div>
				</div>
				<div class="bg-white p-8 rounded-[40px] border border-slate-200 shadow-sm">
					<span class="text-[10px] font-black text-slate-400 uppercase tracking-widest block mb-4">Portfolio Value</span>
					<div class="text-3xl font-black text-slate-950">${portfolioStats.portfolioValue.toLocaleString()}</div>
					<div class="text-[10px] font-bold text-emerald-500 mt-2 uppercase tracking-tighter">Based on Market Multiple</div>
				</div>
			</div>

			<!-- 3. INVENTORY & SCALE (Phase 1) -->
			<div class="grid md:grid-cols-3 gap-6 mb-16">
				<div class="bg-slate-950 text-white p-10 rounded-[48px] shadow-2xl relative overflow-hidden">
					<div class="absolute top-0 right-0 w-32 h-32 bg-blue-500/10 rounded-full blur-3xl"></div>
					<h3 class="text-xs font-black uppercase tracking-[0.4em] text-blue-500 mb-8 italic">Asset Allocation</h3>
					<div class="space-y-6">
						<div class="flex justify-between items-center py-3 border-b border-white/5">
							<span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Leased Assets</span>
							<b class="text-lg">{portfolioStats.leasedAssets}</b>
						</div>
						<div class="flex justify-between items-center py-3 border-b border-white/5">
							<span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Ranking Assets</span>
							<b class="text-lg">{portfolioStats.rankingAssets}</b>
						</div>
						<div class="flex justify-between items-center py-3">
							<span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">States Represented</span>
							<b class="text-lg">{portfolioStats.states}</b>
						</div>
					</div>
				</div>

				<div class="bg-white border border-slate-200 p-10 rounded-[48px] shadow-sm">
					<h3 class="text-xs font-black uppercase tracking-[0.4em] text-slate-400 mb-8">Lead Metrics</h3>
					<div class="space-y-6">
						<div class="flex justify-between items-center py-3 border-b border-slate-50">
							<span class="text-[10px] font-black text-slate-500 uppercase tracking-widest">Total Leads (30d)</span>
							<div class="text-right">
								<b class="text-lg text-slate-950">{portfolioStats.leads30d}</b>
								<span class="text-[9px] font-bold text-emerald-500 block">+{portfolioStats.leads30d - portfolioStats.prevLeads30d} vs prev</span>
							</div>
						</div>
						<div class="flex justify-between items-center py-3 border-b border-slate-50">
							<span class="text-[10px] font-black text-slate-500 uppercase tracking-widest">Avg. Cost Per Lead</span>
							<b class="text-lg text-slate-950">${portfolioStats.avgCPL.toFixed(2)}</b>
						</div>
						<div class="flex justify-between items-center py-3">
							<span class="text-[10px] font-black text-slate-500 uppercase tracking-widest">Network Conversion</span>
							<b class="text-lg text-slate-950">28.4%</b>
						</div>
					</div>
				</div>

				<div class="bg-white border border-slate-200 p-10 rounded-[48px] shadow-sm flex flex-col justify-center text-center relative overflow-hidden">
					<div class="absolute inset-0 bg-blue-50/20 pointer-events-none"></div>
					<span class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-4 relative z-10">Institutional Yield</span>
					<div class="text-6xl font-black text-slate-950 relative z-10">214<span class="text-blue-600">%</span></div>
					<p class="text-slate-400 text-[10px] mt-6 px-4 uppercase font-bold tracking-widest relative z-10">Real-Time Portfolio ROI</p>
				</div>
			</div>

			<!-- Market Dominance Pulse -->
			<div class="bg-white border border-slate-200 rounded-[40px] shadow-sm p-10">
				<div class="flex justify-between items-center mb-10">
					<h3 class="text-xs font-black uppercase tracking-widest text-slate-950">Active Digital Deeds</h3>
					<a href="/dashboard/portfolio" class="text-[10px] font-black uppercase tracking-widest text-blue-600">Full Portfolio View &rarr;</a>
				</div>
				<div class="grid gap-2">
					{territories.map(t => (
						<div class="flex justify-between items-center py-5 border-b border-slate-50 last:border-0 group cursor-pointer hover:px-2 transition-all">
							<div class="flex items-center gap-6">
								<div class={`w-12 h-12 rounded-2xl flex items-center justify-center font-black text-xs ${t.health >= 80 ? 'bg-emerald-50 text-emerald-600' : 'bg-amber-50 text-amber-600'}`}>
									{t.health}
								</div>
								<div>
									<b class="text-sm text-slate-950 uppercase tracking-tight group-hover:text-blue-600 transition-colors">{t.name}</b>
									<div class="flex items-center gap-3 mt-1">
										<span class="text-[10px] text-slate-400 font-mono italic">{t.domain}</span>
										<span class="w-1 h-1 rounded-full bg-slate-200"></span>
										<span class="text-[9px] font-black text-emerald-500 uppercase tracking-widest">Rank {t.ranks.google}</span>
									</div>
								</div>
							</div>
							<div class={`text-[9px] font-black uppercase px-4 py-1.5 rounded-full border ${t.status === 'Leased' ? 'bg-amber-50 border-amber-100 text-amber-600' : 'bg-blue-50 border-blue-100 text-blue-600'}`}>
								{t.status}
							</div>
						</div>
					))}
				</div>
			</div>
		</div>
	</main>
</Layout>
