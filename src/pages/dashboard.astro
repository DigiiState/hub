---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import { getPortfolioStats, getAssets, getAutopilotConfigs, getDecisions, getMonetizationMetrics, getManagementAttention } from '../lib/db';

const portfolioStats = await getPortfolioStats();
const assets = await getAssets();
const configs = await getAutopilotConfigs();
const decisions = await getDecisions();
const monetization = await getMonetizationMetrics();
const managementAttention = await getManagementAttention();
const globalConfig = configs.find(c => c.id === 'global');

// PORTFOLIO PERFORMANCE SUMMARY
const totalMonetizationTarget = monetization.length * 10;
const currentQualifiedNonPaidCalls = monetization.reduce((acc, m) => acc + m.qualifiedCalls, 0);
const monetizationReadyAssets = monetization.filter(m => m.progress >= 100).length;
---


<Layout title="Command Center | DigiiState OS">
	<main class="min-h-screen bg-slate-50 flex">
		<Sidebar activePath="/dashboard" />

		<div class="flex-1 ml-64 p-12">
			<!-- Command Center Header -->
			<header class="flex justify-between items-end mb-16">
				<div>
					<h1 class="text-4xl font-black text-slate-950 uppercase tracking-tighter leading-none">COMMAND CENTER</h1>
					<p class="text-slate-400 text-[10px] font-black uppercase tracking-[0.3em] mt-3">Executive Oversight & Portfolio Performance</p>
				</div>
				<div class="flex gap-4">
					<div class="bg-white border border-slate-200 p-6 rounded-3xl flex gap-12 shadow-sm">
						<div>
							<span class="text-[9px] font-black text-slate-400 uppercase block mb-1">Monetization Ready</span>
							<b class="text-xl text-blue-600">{monetizationReadyAssets} <small class="text-slate-400 font-medium">/ {monetization.length}</small></b>
						</div>
						<div class="w-px h-8 bg-slate-100"></div>
						<div>
							<span class="text-[9px] font-black text-slate-400 uppercase block mb-1">Portfolio Non-Paid Calls</span>
							<b class="text-xl text-emerald-500">{currentQualifiedNonPaidCalls} <small class="text-slate-400 font-medium">/ {totalMonetizationTarget}</small></b>
						</div>
						<div class="w-px h-8 bg-slate-100"></div>
						<div>
							<span class="text-[9px] font-black text-slate-400 uppercase block mb-1">Total Assets</span>
							<b class="text-xl text-slate-950">{portfolioStats.totalAssets}</b>
						</div>
					</div>
				</div>
			</header>

			<!-- 0. DECISIONS REQUIRED (P1B) -->
			{decisions.length > 0 && (
				<section class="mb-16">
					<div class="flex items-center gap-3 mb-8">
						<h3 class="text-xs font-black uppercase tracking-[0.2em] text-blue-600 border-l-4 border-blue-600 pl-4">Decisions Required</h3>
						<span class="text-[9px] font-bold text-slate-400 uppercase tracking-widest">{decisions.length} Pending Approval</span>
					</div>
					<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
						{decisions.map(decision => (
							<div class="bg-white border-2 border-slate-100 rounded-[32px] p-8 shadow-sm hover:border-blue-500 transition-all group relative overflow-hidden">
								<div class="absolute top-0 right-0 px-4 py-2 bg-slate-50 text-[9px] font-black text-slate-400 uppercase tracking-widest rounded-bl-2xl">
									{decision.type.replace(/_/g, ' ')}
								</div>
								
								<div class="mb-6">
									<div class="flex items-center gap-2 mb-2">
										<span class={`w-2 h-2 rounded-full ${decision.priority === 'CRITICAL' || decision.priority === 'URGENT' ? 'bg-red-500 animate-pulse' : 'bg-blue-500'}`}></span>
										<span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">{decision.decision_id}</span>
									</div>
									<h4 class="text-lg font-black text-slate-950 leading-tight mb-2">{decision.title}</h4>
									<p class="text-xs text-slate-500 line-clamp-2">{decision.rationale}</p>
								</div>

								<div class="grid grid-cols-2 gap-4 mb-8">
									<div class="bg-slate-50 p-4 rounded-2xl">
										<span class="text-[8px] font-black text-slate-400 uppercase block mb-1">Proposed Cost</span>
										<b class="text-sm text-slate-950">${Number(decision.cost).toLocaleString()}</b>
									</div>
									<div class="bg-slate-50 p-4 rounded-2xl">
										<span class="text-[8px] font-black text-slate-400 uppercase block mb-1">ROI / Payback</span>
										<b class="text-sm text-emerald-600">{decision.payback_period || 'TBD'}</b>
									</div>
								</div>

								<div class="flex gap-2">
									<button 
										onclick={`openDecisionModal(${JSON.stringify(decision)})`}
										class="flex-1 bg-slate-950 text-white py-4 rounded-2xl font-black text-[10px] uppercase tracking-widest hover:bg-blue-600 transition-all"
									>
										Review Details
									</button>
								</div>
							</div>
						))}
					</div>
				</section>
			)}

			<!-- 1. MONETIZATION READINESS GATE (New P0 Standard) -->
			<section class="mb-16">
				<div class="flex items-center gap-3 mb-8">
					<h3 class="text-xs font-black uppercase tracking-[0.2em] text-emerald-600 border-l-4 border-emerald-600 pl-4">Monetization Readiness</h3>
					<span class="text-[9px] font-bold text-slate-400 uppercase tracking-widest">10 Qualified Calls / 30 Days</span>
				</div>
				<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
					{monetization.sort((a, b) => b.priorityScore - a.priorityScore).map(m => (
						<div class="bg-white border border-slate-200 rounded-[32px] p-8 shadow-sm relative overflow-hidden group">
                            <div class="absolute top-0 right-0 p-4">
                                <div class="text-[7px] font-black uppercase text-slate-300 tracking-[0.3em]">Priority Score</div>
                                <div class="text-right text-sm font-black text-slate-900">{m.priorityScore}</div>
                            </div>
							<div class="flex justify-between items-start mb-6">
								<div>
									<b class="text-slate-950 block uppercase tracking-tight italic">{m.domain}</b>
									<span class="text-[9px] font-black text-slate-400 uppercase tracking-widest">{m.stage}</span>
								</div>
								<div class={`px-3 py-1 rounded-full text-[8px] font-black uppercase tracking-widest ${m.progress >= 100 ? 'bg-emerald-50 text-emerald-600 border border-emerald-100' : 'bg-slate-50 text-slate-400'}`}>
									{m.progress >= 100 ? 'Ready' : 'Indexing'}
								</div>
							</div>

							<div class="space-y-6">
								<div class="flex justify-between items-end">
									<div>
										<span class="text-[9px] font-black text-slate-400 uppercase block mb-1">Non-Paid Qualified Calls</span>
										<b class="text-2xl text-slate-950">{m.qualifiedCalls} <small class="text-slate-400 font-medium">/ 10</small></b>
									</div>
									<div class="text-right">
										<span class="text-[9px] font-black text-slate-400 uppercase block mb-1">Non-Paid Trend</span>
										<b class={`text-sm ${m.qualifiedCalls >= m.prevQualifiedCalls ? 'text-emerald-500' : 'text-red-500'}`}>
											{m.qualifiedCalls >= m.prevQualifiedCalls ? '↑' : '↓'} {Math.abs(m.qualifiedCalls - m.prevQualifiedCalls)}
										</b>
									</div>
								</div>

								<div class="space-y-2">
									<div class="flex justify-between text-[8px] font-black text-slate-400 uppercase tracking-widest">
										<span>Progress to monetization gate</span>
										<span>{Math.round(m.progress)}%</span>
									</div>
									<div class="h-2 bg-slate-50 rounded-full overflow-hidden">
										<div class={`h-full transition-all duration-1000 ${m.progress >= 100 ? 'bg-emerald-500' : 'bg-blue-600'}`} style={`width: ${m.progress}%`}></div>
									</div>
								</div>

								<div class="pt-6 border-t border-slate-50 grid grid-cols-2 gap-4">
									<div>
										<span class="text-[8px] font-black text-slate-400 uppercase block mb-1">Organic Forms</span>
										<b class="text-xs text-slate-600">{m.qualifiedForms}</b>
									</div>
									<div>
										<span class="text-[8px] font-black text-slate-400 uppercase block mb-1">Paid Qual. Calls</span>
										<b class="text-xs text-slate-400">{m.paidQualifiedCalls}</b>
									</div>
								</div>

                                <div class="pt-4 grid grid-cols-3 gap-2 border-t border-slate-50/50 mt-4">
                                    <div class="text-center">
                                        <span class="text-[7px] font-black text-slate-400 uppercase block">Discovered</span>
                                        <b class="text-[10px] text-slate-500">{m.discovered}</b>
                                    </div>
                                    <div class="text-center">
                                        <span class="text-[7px] font-black text-slate-400 uppercase block">Crawled</span>
                                        <b class="text-[10px] text-slate-500">{m.crawled}</b>
                                    </div>
                                    <div class="text-center">
                                        <span class="text-[7px] font-black text-slate-400 uppercase block">Indexed</span>
                                        <b class="text-[10px] text-emerald-500 font-black">{m.indexed}</b>
                                    </div>
                                </div>
							</div>
						</div>
					))}
				</div>
			</section>

			<!-- 2. MANAGEMENT ATTENTION (Phase 1) -->
			<section class="mb-16">
				<div class="flex items-center gap-3 mb-8">
					<h3 class="text-xs font-black uppercase tracking-[0.2em] text-red-600 border-l-4 border-red-600 pl-4">Management Attention</h3>
					<span class="text-[9px] font-bold text-slate-400 uppercase tracking-widest">Action Required</span>
				</div>
				<div class="grid gap-4">
					{managementAttention.map(item => (
						<div class="bg-white border border-slate-200 rounded-2xl p-5 flex justify-between items-center shadow-sm hover:border-blue-200 transition-all group">
							<div class="flex items-center gap-4">
								<div class={`w-2.5 h-2.5 rounded-full ${item.type === 'critical' ? 'bg-red-500 animate-pulse' : item.type === 'warning' ? 'bg-amber-500' : 'bg-emerald-500'}`}></div>
								<span class="text-sm font-bold text-slate-800">{item.message}</span>
							</div>
							<a href={item.target} class="bg-slate-50 text-blue-600 px-4 py-2 rounded-lg font-black text-[10px] uppercase tracking-widest hover:bg-blue-600 hover:text-white transition-all">{item.action} &rarr;</a>
						</div>
					))}
				</div>
			</section>

			<!-- 2. PRIMARY EXECUTIVE METRICS (Phase 1) -->
			<div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-16">
				<div class="bg-white p-8 rounded-[40px] border border-slate-200 shadow-sm relative overflow-hidden">
					<div class="absolute top-0 right-0 w-24 h-24 bg-blue-50 rounded-full translate-x-12 -translate-y-12 blur-2xl"></div>
					<span class="text-[10px] font-black text-slate-400 uppercase tracking-widest block mb-4">Monthly Rent Roll</span>
					<div class="text-3xl font-black text-slate-950">${portfolioStats.monthlyRentRoll.toLocaleString()}</div>
					<div class={`text-[10px] font-bold mt-2 uppercase ${portfolioStats.monthlyRentRoll > portfolioStats.prevRentRoll ? 'text-emerald-500' : 'text-slate-400'}`}>
						{portfolioStats.monthlyRentRoll > portfolioStats.prevRentRoll ? `+${( (portfolioStats.monthlyRentRoll - portfolioStats.prevRentRoll) / portfolioStats.prevRentRoll * 100 ).toFixed(1)}%` : '0%'} vs prev 30d
					</div>
				</div>
				<div class="bg-white p-8 rounded-[40px] border border-slate-200 shadow-sm">
					<span class="text-[10px] font-black text-slate-400 uppercase tracking-widest block mb-4">Monthly NOI</span>
					<div class="text-3xl font-black text-slate-950">${portfolioStats.monthlyNOI.toLocaleString()}</div>
					<div class="text-[10px] font-bold text-slate-400 mt-2 uppercase tracking-tighter">98.4% Operating Margin</div>
				</div>
				<div class="bg-white p-8 rounded-[40px] border border-slate-200 shadow-sm">
					<span class="text-[10px] font-black text-slate-400 uppercase tracking-widest block mb-4">Annualized NOI</span>
					<div class="text-3xl font-black text-slate-950">${portfolioStats.annualizedNOI.toLocaleString()}</div>
					<div class="text-[10px] font-bold text-blue-500 mt-2 uppercase tracking-tighter">Projected Yield</div>
				</div>
				<div class="bg-white p-8 rounded-[40px] border border-slate-200 shadow-sm">
					<span class="text-[10px] font-black text-slate-400 uppercase tracking-widest block mb-4">Portfolio Value</span>
					<div class="text-3xl font-black text-slate-950">${portfolioStats.portfolioValue.toLocaleString()}</div>
					<div class="text-[10px] font-bold text-emerald-500 mt-2 uppercase tracking-tighter">Based on Market Multiple</div>
				</div>
				<div class="bg-slate-900 p-8 rounded-[40px] border border-slate-800 shadow-xl relative overflow-hidden group cursor-pointer" onclick="window.location.href='/dashboard/autopilot'">
					<div class="absolute top-0 right-0 w-24 h-24 bg-blue-600/10 rounded-full translate-x-8 -translate-y-8 blur-2xl group-hover:bg-blue-600/20 transition-all"></div>
					<span class="text-[10px] font-black text-slate-500 uppercase tracking-widest block mb-4">Autopilot Status</span>
					<div class={`text-3xl font-black ${globalConfig?.is_active ? 'text-emerald-500' : 'text-slate-400'}`}>{globalConfig?.is_active ? 'ON' : 'PAUSED'}</div>
					<div class="text-[10px] font-bold text-blue-500 mt-2 uppercase tracking-tighter hover:underline">Manage Governance &rarr;</div>
				</div>
			</div>

			<!-- 3. INVENTORY & SCALE (Phase 1) -->
			<div class="grid md:grid-cols-3 gap-6 mb-16">
				<div class="bg-slate-950 text-white p-10 rounded-[48px] shadow-2xl relative overflow-hidden">
					<div class="absolute top-0 right-0 w-32 h-32 bg-blue-500/10 rounded-full blur-3xl"></div>
					<h3 class="text-xs font-black uppercase tracking-[0.4em] text-blue-500 mb-8 italic">Asset Allocation</h3>
					<div class="space-y-6">
						<div class="flex justify-between items-center py-3 border-b border-white/5">
							<span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Leased Assets</span>
							<b class="text-lg">{portfolioStats.leasedAssets}</b>
						</div>
						<div class="flex justify-between items-center py-3 border-b border-white/5">
							<span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Ranking Assets</span>
							<b class="text-lg">{portfolioStats.rankingAssets}</b>
						</div>
						<div class="flex justify-between items-center py-3">
							<span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">States Represented</span>
							<b class="text-lg">{portfolioStats.states}</b>
						</div>
					</div>
				</div>

				<div class="bg-white border border-slate-200 p-10 rounded-[48px] shadow-sm">
					<h3 class="text-xs font-black uppercase tracking-[0.4em] text-slate-400 mb-8">Lead Metrics</h3>
					<div class="space-y-6">
						<div class="flex justify-between items-center py-3 border-b border-slate-50">
							<span class="text-[10px] font-black text-slate-500 uppercase tracking-widest">Total Leads (30d)</span>
							<div class="text-right">
								<b class="text-lg text-slate-950">{portfolioStats.leads30d}</b>
								<span class="text-[9px] font-bold text-emerald-500 block">+{portfolioStats.leads30d - portfolioStats.prevLeads30d} vs prev</span>
							</div>
						</div>
						<div class="flex justify-between items-center py-3 border-b border-slate-50">
							<span class="text-[10px] font-black text-slate-500 uppercase tracking-widest">Avg. Cost Per Lead</span>
							<b class="text-lg text-slate-950">${portfolioStats.avgCPL.toFixed(2)}</b>
						</div>
						<div class="flex justify-between items-center py-3">
							<span class="text-[10px] font-black text-slate-500 uppercase tracking-widest">Network Conversion</span>
							<b class="text-lg text-slate-950">28.4%</b>
						</div>
					</div>
				</div>

				<div class="bg-white border border-slate-200 p-10 rounded-[48px] shadow-sm flex flex-col justify-center text-center relative overflow-hidden">
					<div class="absolute inset-0 bg-blue-50/20 pointer-events-none"></div>
					<span class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-4 relative z-10">Institutional Yield</span>
					<div class="text-6xl font-black text-slate-950 relative z-10">214<span class="text-blue-600">%</span></div>
					<p class="text-slate-400 text-[10px] mt-6 px-4 uppercase font-bold tracking-widest relative z-10">Real-Time Portfolio ROI</p>
				</div>
			</div>

			<!-- Market Dominance Pulse -->
			<div class="bg-white border border-slate-200 rounded-[40px] shadow-sm p-10">
				<div class="flex justify-between items-center mb-10">
					<h3 class="text-xs font-black uppercase tracking-widest text-slate-950">Active Digital Deeds</h3>
					<a href="/dashboard/portfolio" class="text-[10px] font-black uppercase tracking-widest text-blue-600">Full Portfolio View &rarr;</a>
				</div>
				<div class="grid gap-2">
					{territories.map(t => (
						<div class="flex justify-between items-center py-5 border-b border-slate-50 last:border-0 group cursor-pointer hover:px-2 transition-all">
							<div class="flex items-center gap-6">
								<div class={`w-12 h-12 rounded-2xl flex items-center justify-center font-black text-xs ${t.health >= 80 ? 'bg-emerald-50 text-emerald-600' : 'bg-amber-50 text-amber-600'}`}>
									{t.health}
								</div>
								<div>
									<b class="text-sm text-slate-950 uppercase tracking-tight group-hover:text-blue-600 transition-colors">{t.name}</b>
									<div class="flex items-center gap-3 mt-1">
										<span class="text-[10px] text-slate-400 font-mono italic">{t.domain}</span>
										<span class="w-1 h-1 rounded-full bg-slate-200"></span>
										<span class="text-[9px] font-black text-emerald-500 uppercase tracking-widest">Rank {t.ranks.google}</span>
									</div>
								</div>
							</div>
							<div class={`text-[9px] font-black uppercase px-4 py-1.5 rounded-full border ${t.status === 'Leased' ? 'bg-amber-50 border-amber-100 text-amber-600' : 'bg-blue-50 border-blue-100 text-blue-600'}`}>
								{t.status}
							</div>
						</div>
					))}
				</div>
			</div>
		</div>
	</main>

	<!-- DECISION MODAL -->
	<div id="decisionModal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-6">
		<div class="bg-white w-full max-w-2xl rounded-[40px] shadow-2xl overflow-hidden relative">
			<button onclick="closeDecisionModal()" class="absolute top-8 right-8 text-slate-400 hover:text-slate-950 transition-colors">
				<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
			</button>

			<div class="p-12">
				<div class="flex items-center gap-3 mb-8">
					<span id="modalType" class="text-[9px] font-black text-blue-600 uppercase tracking-[0.3em] bg-blue-50 px-3 py-1 rounded-full">TYPE</span>
					<span id="modalId" class="text-[9px] font-black text-slate-400 uppercase tracking-widest">DEC-000</span>
				</div>

				<h2 id="modalTitle" class="text-3xl font-black text-slate-950 mb-6 leading-tight">Decision Title</h2>
				
				<div class="space-y-8 mb-12">
					<div>
						<h5 class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-3">Lori's Recommendation</h5>
						<div class="bg-emerald-50 border border-emerald-100 p-6 rounded-3xl">
							<p id="modalRationale" class="text-sm text-slate-800 leading-relaxed font-medium">Rationale goes here...</p>
						</div>
					</div>

					<div class="grid grid-cols-3 gap-6">
						<div class="bg-slate-50 p-6 rounded-3xl">
							<span class="text-[8px] font-black text-slate-400 uppercase block mb-1">Proposed Cost</span>
							<b id="modalCost" class="text-lg text-slate-950">$0.00</b>
						</div>
						<div class="bg-slate-50 p-6 rounded-3xl">
							<span class="text-[8px] font-black text-slate-400 uppercase block mb-1">Payback</span>
							<b id="modalPayback" class="text-lg text-slate-950">3 Months</b>
						</div>
						<div class="bg-slate-50 p-6 rounded-3xl">
							<span class="text-[8px] font-black text-slate-400 uppercase block mb-1">Risk Level</span>
							<b id="modalRisk" class="text-lg text-amber-600 uppercase">LOW</b>
						</div>
					</div>

					<div>
						<h5 class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-3">Technical Evidence</h5>
						<div id="modalEvidence" class="text-[11px] font-mono text-slate-500 bg-slate-50 p-4 rounded-xl overflow-x-auto">
							No technical evidence provided.
						</div>
					</div>
				</div>

				<div class="flex flex-col sm:flex-row gap-4">
					<button id="rejectBtn" class="flex-1 bg-white border-2 border-slate-100 text-slate-400 py-5 rounded-[24px] font-black text-xs uppercase tracking-[0.2em] hover:border-red-500 hover:text-red-500 transition-all">
						Reject Action
					</button>
					<button id="approveBtn" class="flex-[2] bg-slate-950 text-white py-5 px-12 rounded-[24px] font-black text-xs uppercase tracking-[0.2em] hover:bg-blue-600 transition-all shadow-xl shadow-blue-500/10">
						Approve & Execute
					</button>
				</div>
			</div>
		</div>
	</div>

	<script is:inline>
		let currentDecision = null;

		window.openDecisionModal = (decision) => {
			currentDecision = decision;
			document.getElementById('modalType').innerText = decision.type.replace(/_/g, ' ');
			document.getElementById('modalId').innerText = decision.decision_id;
			document.getElementById('modalTitle').innerText = decision.title;
			document.getElementById('modalRationale').innerText = decision.rationale;
			document.getElementById('modalCost').innerText = `$${Number(decision.cost).toLocaleString()}`;
			document.getElementById('modalPayback').innerText = decision.payback_period || 'TBD';
			document.getElementById('modalRisk').innerText = decision.risk_level || 'LOW';
			document.getElementById('modalEvidence').innerText = decision.evidence ? JSON.stringify(decision.evidence, null, 2) : 'No technical evidence provided.';
			
			document.getElementById('decisionModal').classList.remove('hidden');
		};

		window.closeDecisionModal = () => {
			document.getElementById('decisionModal').classList.add('hidden');
			currentDecision = null;
		};

		const handleAction = async (status) => {
			if (!currentDecision) return;
			
			const btn = status === 'APPROVED' ? document.getElementById('approveBtn') : document.getElementById('rejectBtn');
			const originalText = btn.innerText;
			btn.innerText = 'PROCESSING...';
			btn.disabled = true;

			try {
				const res = await fetch('/api/decisions', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						decisionId: currentDecision.id,
						status: status,
						rationale: 'Owner decision via Command Center'
					})
				});

				const result = await res.json();
				if (result.error) {
					alert(`Error: ${result.error}`);
				} else {
					window.location.reload();
				}
			} catch (e) {
				alert('System Error: Failed to process decision.');
			} finally {
				btn.innerText = originalText;
				btn.disabled = false;
			}
		};

		document.getElementById('approveBtn').onclick = () => handleAction('APPROVED');
		document.getElementById('rejectBtn').onclick = () => handleAction('REJECTED');
	</script>
</Layout>
