---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Admin Login | DigiiState HQ">
	<main class="min-h-screen bg-slate-50 flex items-center justify-center p-6">
		<div class="max-w-md w-full bg-white border border-slate-200 p-10 rounded-[40px] shadow-2xl">
			<div class="text-center mb-12">
				<div class="text-2xl font-[900] tracking-tighter italic text-slate-950 mb-2">
					Digii<span class="text-blue-600">State</span>
				</div>
				<p class="text-xs font-black uppercase tracking-[0.2em] text-slate-400">Institutional Access Only</p>
			</div>

			<form class="space-y-8" id="loginForm">
				<div class="space-y-4">
					<div class="relative">
						<label class="block text-[10px] font-black uppercase text-slate-400 mb-2 tracking-[0.2em]">Email</label>
						<input type="email" id="emailInput" class="w-full bg-slate-50 border-b-2 border-slate-200 py-3 text-lg outline-none focus:border-blue-600 transition-all font-bold text-slate-950 px-4 rounded-t-xl" placeholder="admin@digiistate.com" required />
					</div>
					<div class="relative">
						<label class="block text-[10px] font-black uppercase text-slate-400 mb-2 tracking-[0.2em]">Password</label>
						<input type="password" id="passKey" class="w-full bg-slate-50 border-b-2 border-slate-200 py-3 text-lg outline-none focus:border-blue-600 transition-all font-bold text-slate-950 px-4 rounded-t-xl" placeholder="••••••••" required />
					</div>
				</div>

				<div id="error" class="text-[10px] font-bold text-red-500 uppercase text-center hidden">Access Denied: Invalid Credentials</div>

				<button type="submit" id="submitBtn" class="w-full bg-slate-950 text-white py-5 rounded-[24px] font-black uppercase tracking-[0.3em] text-xs transition-all shadow-xl hover:bg-blue-600 active:scale-95 flex items-center justify-center gap-3">
					<span id="btnText">Sign In</span>
					<div id="spinner" class="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin hidden"></div>
				</button>
			</form>

			<div class="mt-12 pt-8 border-t border-slate-100 text-center">
				<p class="text-[9px] text-slate-400 uppercase tracking-widest leading-loose">
					Secure session is monitored by Digiistate HQ. System usage is subject to brokerage governance protocols.
				</p>
			</div>
		</div>
	</main>
</Layout>

<script>
	import { supabase } from '../lib/supabase';

	const form = document.getElementById('loginForm');
	const emailInput = document.getElementById('emailInput') as HTMLInputElement;
	const keyInput = document.getElementById('passKey') as HTMLInputElement;
	const error = document.getElementById('error');
	const btnText = document.getElementById('btnText');
	const spinner = document.getElementById('spinner');

	form?.addEventListener('submit', async (e) => {
		e.preventDefault();
		
		error?.classList.add('hidden');
		btnText!.textContent = 'AUTHORIZING...';
		spinner?.classList.remove('hidden');

		const { data, error: authError } = await supabase.auth.signInWithPassword({
			email: emailInput.value,
			password: keyInput.value,
		});

		if (authError || !data.user) {
			error!.textContent = authError?.message || 'Invalid Credentials';
			error?.classList.remove('hidden');
			btnText!.textContent = 'Initialize System';
			spinner?.classList.add('hidden');
			return;
		}

		// Check role
		const { data: profile } = await supabase
			.from('profiles')
			.select('role')
			.eq('id', data.user.id)
			.single();

		if (profile?.role !== 'admin') {
			await supabase.auth.signOut();
			error!.textContent = 'Access Denied: Admin Role Required';
			error?.classList.remove('hidden');
			btnText!.textContent = 'Initialize System';
			spinner?.classList.add('hidden');
			return;
		}

		// Set a secure session cookie for the middleware
		// In production, we should use a more secure method, but this replaces the static key.
		document.cookie = `DS_SESSION=${data.session?.access_token}; path=/; max-age=86400; SameSite=Lax; Secure`;
		window.location.href = '/dashboard/';
	});
</script>
