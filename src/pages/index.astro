---
import Layout from '../layouts/Layout.astro';

// This would eventually be fetched from Supabase
const territories = [
	{ name: "Phoenix MD Septic", status: "Occupied", niche: "Septic", lat: "30%", left: "65%" },
	{ name: "Clarksville Septic", status: "Open", niche: "Septic", lat: "45%", left: "55%" },
	{ name: "Gibson Island Tree", status: "Open", niche: "Tree", lat: "55%", left: "75%" },
	{ name: "Annapolis DUI Law", status: "Open", niche: "Law", lat: "60%", left: "70%" },
];

const liveLeads = [
	{ time: "18m ago", niche: "Septic", city: "Phoenix" },
	{ time: "1h ago", niche: "Law", city: "Annapolis" },
	{ time: "4h ago", niche: "Tree", city: "Gibson Island" },
];
---

<Layout title="DigiiState | Maryland Digital Real Estate Brokerage">
	<main class="bg-slate-950 text-white min-h-screen">
		<!-- 1. Live Lead Ticker -->
		<div class="bg-blue-600/10 border-b border-blue-500/20 py-3 overflow-hidden whitespace-nowrap">
			<div class="inline-block animate-marquee uppercase tracking-widest text-[10px] font-black text-blue-400 px-6">
				{liveLeads.map(lead => (
					<span class="mr-12">📡 LIVE NETWORK PULSE: [{lead.time}] {lead.niche} Lead in {lead.city}, MD</span>
				))}
				{liveLeads.map(lead => (
					<span class="mr-12">📡 LIVE NETWORK PULSE: [{lead.time}] {lead.niche} Lead in {lead.city}, MD</span>
				))}
			</div>
		</div>

		<div class="max-w-6xl mx-auto px-6 py-12">
			<!-- Header -->
			<header class="flex justify-between items-center mb-24">
				<div class="text-2xl font-black tracking-tighter italic">
					Digii<span class="text-blue-500">State</span>
				</div>
				<nav class="flex gap-8 text-[10px] uppercase font-bold tracking-widest text-slate-500">
					<a href="#map" class="hover:text-white transition-colors">Territories</a>
					<a href="#apply" class="text-blue-500 hover:text-blue-400 transition-colors border border-blue-500/30 px-4 py-2 rounded-full">Apply For Monopoly</a>
				</nav>
			</header>

			<!-- Hero Section -->
			<section class="mb-32 text-center max-w-3xl mx-auto">
				<h2 class="text-5xl md:text-7xl font-black mb-8 leading-[0.9] tracking-tighter">
					WE CONTROL THE <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-500 to-indigo-400">TERRITORY.</span><br/>
					YOU RUN THE BUSINESS.
				</h2>
				<p class="text-slate-400 text-lg leading-relaxed mb-12">
					Maryland's premier digital real estate brokerage. We build, rank, and rent hyper-local high-intent search assets in the state's most exclusive enclaves.
				</p>
				<div class="flex flex-col md:flex-row justify-center gap-4">
					<a href="#map" class="bg-blue-600 hover:bg-blue-700 text-white px-10 py-4 font-black uppercase tracking-widest text-xs transition-all rounded shadow-xl shadow-blue-600/20">View Available Land</a>
					<a href="#apply" class="bg-white/5 hover:bg-white/10 text-white border border-white/10 px-10 py-4 font-black uppercase tracking-widest text-xs transition-all rounded">Partner Login</a>
				</div>
			</section>

			<!-- 2. Territory Map (The Scarcity Engine) -->
			<section id="map" class="mb-40">
				<div class="text-center mb-12">
					<h3 class="text-sm font-black uppercase tracking-[0.3em] text-blue-500 mb-4">Maryland Control Map</h3>
					<p class="text-slate-500">Real-time occupancy status of DigiiState assets.</p>
				</div>
				
				<div class="relative bg-slate-900 border border-slate-800 rounded-3xl p-12 overflow-hidden shadow-2xl">
					<div class="aspect-[16/9] w-full bg-[url('https://upload.wikimedia.org/wikipedia/commons/e/e0/Maryland_location_map.svg')] bg-contain bg-center bg-no-repeat opacity-20 grayscale invert contrast-125 brightness-150"></div>
					
					<!-- Interactive Markers -->
					{territories.map(t => (
						<div 
							class={`absolute w-4 h-4 rounded-full border-2 border-white shadow-[0_0_15px_rgba(255,255,255,0.5)] cursor-pointer hover:scale-125 transition-transform group`}
							style={`top: ${t.lat}; left: ${t.left}; background-color: ${t.status === 'Occupied' ? '#f59e0b' : '#10b981'}`}
						>
							<div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-4 w-48 bg-slate-900 border border-slate-700 p-4 rounded-xl opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none z-50">
								<div class="text-[10px] font-black uppercase text-blue-500 mb-1">{t.niche}</div>
								<div class="font-bold text-sm mb-2">{t.name}</div>
								<div class={`text-[10px] font-bold uppercase ${t.status === 'Occupied' ? 'text-orange-500' : 'text-green-500'}`}>
									{t.status === 'Occupied' ? '🔒 OCCUPIED' : '🔓 AVAILABLE'}
								</div>
							</div>
						</div>
					))}
				</div>
			</section>

			<!-- 3. Monopoly Application (The Filter) -->
			<section id="apply" class="grid md:grid-cols-2 gap-20 items-center">
				<div>
					<h3 class="text-4xl font-black tracking-tighter mb-8 uppercase italic">Secure Your <span class="text-blue-500 underline decoration-4">Monopoly.</span></h3>
					<p class="text-slate-400 leading-relaxed mb-8">
						We don't work with everyone. DigiiState only partners with one service provider per territory. If you want to dominate your local market without the headache of Google Ads or unpredictable SEO, apply to join our network.
					</p>
					<ul class="space-y-4 font-bold text-sm uppercase tracking-widest text-slate-300">
						<li class="flex items-center gap-3"><span class="text-blue-500 text-xl">⚡</span> Exclusive Territory Rights</li>
						<li class="flex items-center gap-3"><span class="text-blue-500 text-xl">⚡</span> AI-Triaged High-Intent Leads</li>
						<li class="flex items-center gap-3"><span class="text-blue-500 text-xl">⚡</span> 100% Transparency Dashboard</li>
					</ul>
				</div>

				<div class="bg-slate-900 border border-slate-800 p-10 rounded-3xl shadow-2xl">
					<h4 class="text-xs font-black uppercase tracking-[0.2em] text-blue-500 mb-8">Territory Application</h4>
					<form class="space-y-6">
						<div>
							<label class="block text-[10px] font-black uppercase text-slate-500 mb-2 tracking-widest">Business Name</label>
							<input type="text" class="w-full bg-slate-950 border border-slate-800 p-4 rounded-xl outline-none focus:border-blue-500 transition-colors" placeholder="Young Septic Services" />
						</div>
						<div>
							<label class="block text-[10px] font-black uppercase text-slate-500 mb-2 tracking-widest">Target Maryland City</label>
							<select class="w-full bg-slate-950 border border-slate-800 p-4 rounded-xl outline-none focus:border-blue-500 transition-colors">
								<option>Phoenix, MD</option>
								<option>Clarksville, MD</option>
								<option>Gibson Island, MD</option>
								<option>Annapolis, MD</option>
							</select>
						</div>
						<div>
							<label class="block text-[10px] font-black uppercase text-slate-500 mb-2 tracking-widest">Monthly Ad Spend</label>
							<input type="text" class="w-full bg-slate-950 border border-slate-800 p-4 rounded-xl outline-none focus:border-blue-500 transition-colors" placeholder="$2,500+" />
						</div>
						<button class="w-full bg-blue-600 hover:bg-blue-700 text-white py-5 font-black uppercase tracking-widest text-xs transition-all rounded-xl shadow-xl shadow-blue-600/20">Submit Application</button>
					</form>
				</div>
			</section>

			<footer class="mt-40 pt-10 border-t border-slate-800 flex justify-between items-center text-[10px] font-bold uppercase tracking-widest text-slate-600">
				<div>&copy; 2026 DigiiState Maryland</div>
				<div>Independent Territory Expansion Agency</div>
			</footer>
		</div>
	</main>
</Layout>

<style>
	@keyframes marquee {
		0% { transform: translateX(0); }
		100% { transform: translateX(-50%); }
	}
	.animate-marquee {
		display: inline-block;
		animation: marquee 30s linear infinite;
	}
</style>
