---
import Layout from '../layouts/Layout.astro';
import { getPortfolioStats, getAssets } from '../lib/db';

const portfolioStats = await getPortfolioStats();
const assets = await getAssets();

// National Territory Data (Top performers for Map)
const mapTerritories = assets.slice(0, 5).map((a, i) => ({
    name: a.name,
    status: a.stage === 'Leased' ? 'Occupied' : 'Open',
    niche: a.name.split(' ')[2] || 'Service',
    top: ["38%", "68%", "85%", "18%", "35%"][i],
    left: ["86%", "48%", "82%", "12%", "62%"][i],
    state: a.state
}));

const liveLeads = [
	{ time: "4m ago", niche: "SEPTIC", city: "PHOENIX, MD", ticker: "LEAD.MD.PHX", val: "+$450.00" },
	{ time: "28m ago", niche: "ROOFING", city: "DALLAS, TX", ticker: "LEAD.TX.DAL", val: "+$2,800.00" },
	{ time: "1h ago", niche: "LAW", city: "ANNAPOLIS, MD", ticker: "LEAD.MD.ANN", val: "+$1,500.00" },
	{ time: "3h ago", niche: "WATER", city: "TAMPA, FL", ticker: "LEAD.FL.TPA", val: "+$9,200.00" },
];
---

<Layout title="DigiiState | Digital Real Estate Infrastructure">
	<main class="relative bg-white border-t-4 border-[#0040ff]">
		
		<!-- 1. LIVE LEAD TICKER -->
		<div class="fixed top-1 left-0 w-full z-[100] bg-white border-y border-slate-200 py-1 overflow-hidden h-8">
			<div class="flex whitespace-nowrap animate-marquee">
				<div class="flex gap-12 px-6 items-center">
					{liveLeads.map(lead => (
						<div class="flex items-center gap-2 font-['IBM_Plex_Mono'] text-[11px]">
							<span class="font-bold text-[#0040ff]">{lead.ticker}</span>
							<span class="text-slate-400">{lead.time}</span>
							<span class="font-bold text-emerald-600">{lead.val}</span>
						</div>
					))}
				</div>
				<div class="flex gap-12 px-6 items-center">
					{liveLeads.map(lead => (
						<div class="flex items-center gap-2 font-['IBM_Plex_Mono'] text-[11px]">
							<span class="font-bold text-[#0040ff]">{lead.ticker}</span>
							<span class="text-slate-400">{lead.time}</span>
							<span class="font-bold text-emerald-600">{lead.val}</span>
						</div>
					))}
				</div>
			</div>
		</div>

		<div class="max-w-7xl mx-auto px-8 pt-16 pb-20">
			<!-- Header -->
			<header class="flex justify-between items-center py-6 border-b border-slate-200 mb-12">
				<div class="flex items-center gap-10">
					<div class="text-2xl font-bold tracking-tighter text-[#0f172a] uppercase">
						Digii<span class="text-[#0040ff]">State</span>
					</div>
					<nav class="hidden lg:flex gap-8 text-[11px] font-bold uppercase tracking-wider text-slate-500">
						<a href="#map" class="hover:text-[#0040ff] transition-colors">Infrastructure</a>
						<a href="#economics" class="hover:text-[#0040ff] transition-colors">Yield Logic</a>
						<a href="/governance" class="hover:text-[#0040ff] transition-colors">Governance</a>
					</nav>
				</div>
				<div class="flex items-center gap-4">
					<a href="/admin" class="text-[11px] font-bold uppercase text-slate-500 hover:text-black">Operator Login</a>
					<div class="h-4 w-px bg-slate-200 mx-2"></div>
					<a href="#apply" class="bg-[#0040ff] text-white px-5 py-2 font-bold text-[11px] uppercase tracking-wider hover:bg-blue-700 transition-colors">
						Apply for Territory
					</a>
				</div>
			</header>

			<!-- 2. DATA-CENTRIC HERO -->
			<div class="grid lg:grid-cols-12 gap-16 mb-24">
				<div class="lg:col-span-7">
					<div class="inline-block px-2 py-1 bg-slate-100 text-[10px] font-bold text-slate-600 uppercase mb-6">Market Update: Aug 2026</div>
					<h1 class="text-6xl md:text-8xl font-bold mb-8 leading-[0.9] tracking-tighter text-[#0f172a]">
						DIGITAL REAL <br/>
						<span class="text-[#0040ff]">ESTATE INFRA.</span>
					</h1>
					<p class="text-slate-500 text-xl leading-relaxed mb-10 max-w-xl">
						DigiiState develops and operates high-yield digital territories. We own the "Digital Deeds" to high-ranking local properties and lease exclusive lead flow to premium service providers.
					</p>
					
					<div class="grid grid-cols-3 gap-8 pt-8 border-t border-slate-100">
						<div>
							<span class="text-[10px] font-bold text-slate-400 uppercase block mb-1">Portfolio Equity</span>
							<span class="text-3xl font-bold text-slate-900">${(portfolioStats.portfolioValue / 1000).toFixed(0)}k</span>
						</div>
						<div>
							<span class="text-[10px] font-bold text-slate-400 uppercase block mb-1">Monthly Leads</span>
							<span class="text-3xl font-bold text-slate-900">{portfolioStats.leads30d}</span>
						</div>
						<div>
							<span class="text-[10px] font-bold text-slate-400 uppercase block mb-1">Retention</span>
							<span class="text-3xl font-bold text-slate-900">{portfolioStats.retentionRate}%</span>
						</div>
					</div>
				</div>

				<div class="lg:col-span-5">
					<div class="border border-slate-200 p-8 bg-slate-50">
						<div class="flex justify-between items-center mb-6">
							<h3 class="text-xs font-bold uppercase text-slate-900">Portfolio Performance</h3>
							<span class="text-[10px] font-mono text-emerald-600 font-bold">OS STATUS: NOMINAL</span>
						</div>
						<div class="space-y-4 font-['IBM_Plex_Mono'] text-xs">
							{assets.slice(0, 4).map(a => (
                                <div class="flex justify-between border-b border-slate-200 pb-2">
                                    <span class="text-slate-400 uppercase">{a.name.replace(/ /g, '.')}</span>
                                    <span class="font-bold text-slate-900">RANK {a.rank}</span>
                                </div>
                            ))}
						</div>
						<button class="w-full mt-8 border border-slate-300 py-3 text-[10px] font-bold uppercase tracking-widest hover:bg-white transition-colors">
							View Available Deeds
						</button>
					</div>
				</div>
			</div>

			<!-- 3. GEOGRAPHIC TERMINAL MAP -->
			<section id="map" class="pt-20 border-t border-slate-100">
				<div class="flex justify-between items-end mb-12">
					<div>
						<h3 class="text-[10px] font-bold uppercase tracking-widest text-[#0040ff] mb-2">US Digital Territory Monitor</h3>
						<h2 class="text-4xl font-bold uppercase text-slate-900">Infrastructure Map</h2>
					</div>
					<div class="flex gap-4 text-[10px] font-bold uppercase tracking-widest text-slate-400">
						<span class="flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-emerald-500"></span> Open</span>
						<span class="flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-amber-500"></span> Leased</span>
					</div>
				</div>
				
				<div class="bg-slate-50 border border-slate-200 p-8 md:p-16 relative overflow-hidden">
					<div class="relative w-full aspect-[21/9]">
						<svg viewBox="0 0 1000 589" class="w-full h-full fill-slate-200 stroke-white stroke-[2]" xmlns="http://www.w3.org/2000/svg">
							<path d="M968.12,185.08 L958.01,177.01 L942.87,175 L933.28,162.89 L924.71,165.91 L921.68,155.82 L904,151.28 L897.44,142.2 L897.44,129.59 L881.3,131.61 L874.24,142.2 L863.64,142.2 L859.6,155.32 L840.43,158.85 L840.43,165.91 L831.35,166.41 L823.28,155.82 L814.71,155.32 L807.64,142.2 L794.52,142.2 L787.46,153.3 L778.38,150.28 L773.34,142.2 L756.19,142.2 L756.19,150.28 L749.12,150.28 L745.09,142.2 L737.52,142.2 L730.46,145.22 L722.89,142.2 L715.32,142.2 L708.26,145.22 L700.69,142.2 L689.59,145.22 L682.02,142.2 L664.87,142.2 L657.31,145.22 L649.74,142.2 L634.61,142.2 L627.04,145.22 L619.47,142.2 L604.34,142.2 L596.77,145.22 L589.21,142.2 L574.07,142.2 L566.5,145.22 L558.94,142.2 L543.81,142.2 L536.24,145.22 L528.67,142.2 L513.54,142.2 L505.97,145.22 L498.41,142.2 L483.27,142.2 L475.7,145.22 L468.14,142.2 L453,142.2 L445.43,145.22 L437.87,142.2 L422.73,142.2 L415.17,145.22 L407.6,142.2 L392.47,142.2 L384.9,145.22 L377.34,142.2 L362.2,142.2 L354.64,145.22 L347.07,142.2 L331.94,142.2 L324.37,145.22 L316.8,142.2 L301.67,142.2 L294.1,145.22 L286.54,142.2 L271.4,142.2 L263.84,145.22 L256.27,142.2 L241.14,142.2 L233.57,145.22 L226,142.2 L210.87,142.2 L203.3,145.22 L195.74,142.2 L180.6,142.2 L173.04,145.22 L165.47,142.2 L150.34,142.2 L142.77,145.22 L135.21,142.2 L120.07,142.2 L112.51,145.22 L104.94,142.2 L89.81,142.2 L82.24,145.22 L74.67,142.2 L59.54,142.2 L51.97,145.22 L44.41,142.2 L29.27,142.2 L21.71,145.22 L14.14,142.2 L0,142.2 L0,589 L1000,589 L1000,185.08 L968.12,185.08 Z"></path>
						</svg>

						{mapTerritories.map(t => (
							<div 
								class="absolute group cursor-pointer"
								style={`top: ${t.top}; left: ${t.left};`}
							>
								<div class={`w-3 h-3 rounded-sm border-2 border-white shadow-sm rotate-45 ${t.status === 'Occupied' ? 'bg-amber-500' : 'bg-emerald-500'}`}></div>
								<div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-4 w-40 p-4 bg-white border border-slate-200 rounded shadow-2xl opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none z-50">
									<div class="text-[10px] font-bold text-slate-400 uppercase mb-1">{t.niche}</div>
									<div class="font-bold text-xs text-slate-900 uppercase">{t.name}</div>
								</div>
							</div>
						))}
					</div>
				</div>
			</section>

			<!-- 4. YIELD LOGIC -->
			<section id="economics" class="py-24 grid md:grid-cols-2 gap-20 border-t border-slate-100">
				<div>
					<h3 class="text-[10px] font-bold uppercase tracking-widest text-[#0040ff] mb-2">Acquisition Logic</h3>
					<h2 class="text-4xl font-bold uppercase text-slate-900 mb-8 leading-tight">FIXED LEASES <br/>VS. PPC TAXATION.</h2>
					<p class="text-slate-500 leading-relaxed mb-8">
						Google Ads sells temporary clicks. We build permanent digital assets. Our territories provide 100% exclusive local demand at a predictable fixed monthly rent.
					</p>
					<div class="space-y-4 text-xs font-bold uppercase tracking-wider">
						<div class="flex items-center gap-3 text-red-500">
							<span class="w-4 h-px bg-red-500"></span> [X] PAY-PER-CLICK: VARIABLE / SHARED / RENTED
						</div>
						<div class="flex items-center gap-3 text-emerald-600">
							<span class="w-4 h-px bg-emerald-600"></span> [✓] DIGIISTATE DEEDS: FIXED / EXCLUSIVE / OWNED
						</div>
					</div>
				</div>
				<div class="bg-slate-50 p-10 border border-slate-200">
					<h4 class="text-[10px] font-bold text-slate-400 uppercase mb-10 text-center tracking-[0.2em]">Target Asset Performance</h4>
					<div class="space-y-8 font-['IBM_Plex_Mono']">
						<div class="flex justify-between border-b border-slate-200 pb-4">
							<span class="text-slate-500 text-xs uppercase tracking-widest">Avg Lease / Mo</span>
							<span class="text-xl font-bold">$1,250.00</span>
						</div>
						<div class="flex justify-between border-b border-slate-200 pb-4">
							<span class="text-slate-500 text-xs uppercase tracking-widest">Avg Leads / Mo</span>
							<span class="text-xl font-bold">15-30</span>
						</div>
						<div class="flex justify-between">
							<span class="text-slate-500 text-xs uppercase tracking-widest">Operator Equity</span>
							<span class="text-3xl font-bold text-[#0040ff]">100%</span>
						</div>
					</div>
				</div>
			</section>

			<!-- 5. PARTNERSHIP APPLICATION -->
			<section id="apply" class="py-24 border-t border-slate-900 pt-32">
				<div class="max-w-4xl mx-auto text-center mb-16">
					<h2 class="text-5xl font-bold uppercase tracking-tighter text-slate-950 mb-6">Secure Your Territory</h2>
					<p class="text-slate-500 text-lg max-w-2xl mx-auto">Digital deeds are limited to one partner per niche per city. Submit credentials below for acquisition approval.</p>
				</div>
				
				<div class="max-w-4xl mx-auto border border-slate-200 p-12 bg-slate-50">
					<form class="grid md:grid-cols-2 gap-12">
						<div class="space-y-8">
							<div class="border-b border-slate-200 py-2">
								<label class="block text-[10px] font-bold uppercase text-slate-400 mb-2">Legal Entity</label>
								<input type="text" class="w-full bg-transparent outline-none font-bold text-slate-950" placeholder="Business Name" />
							</div>
							<div class="border-b border-slate-200 py-2">
								<label class="block text-[10px] font-bold uppercase text-slate-400 mb-2">Point of Contact</label>
								<input type="email" class="w-full bg-transparent outline-none font-bold text-slate-950" placeholder="Email Address" />
							</div>
						</div>
						<div class="space-y-8">
							<div class="border-b border-slate-200 py-2">
								<label class="block text-[10px] font-bold uppercase text-slate-400 mb-2">Target Market</label>
								<input type="text" class="w-full bg-transparent outline-none font-bold text-slate-950" placeholder="City, State" />
							</div>
							<div class="border-b border-slate-200 py-2">
								<label class="block text-[10px] font-bold uppercase text-slate-400 mb-2">Current Ads Spend</label>
								<input type="text" class="w-full bg-transparent outline-none font-bold text-slate-950" placeholder="$2,500 - $10k" />
							</div>
						</div>
						<button class="md:col-span-2 bg-[#0040ff] text-white py-6 font-bold uppercase tracking-[0.3em] text-xs hover:bg-blue-700 transition-all">
							Request Asset Audit
						</button>
					</form>
				</div>
			</section>

			<footer class="mt-32 pt-12 border-t border-slate-200 flex flex-col md:flex-row justify-between items-center gap-8 text-[10px] font-bold uppercase tracking-widest text-slate-400">
				<div>&copy; 2026 DIGIISTATE INFRASTRUCTURE CORP</div>
				<div class="flex gap-12">
					<a href="/governance" class="hover:text-black">Governance</a>
					<a href="/tos" class="hover:text-black">Terms of Service</a>
					<a href="/privacy" class="hover:text-black">Privacy</a>
				</div>
			</footer>
		</div>
	</main>
</Layout>

<style>
	@keyframes marquee {
		0% { transform: translateX(0); }
		100% { transform: translateX(-50%); }
	}
	.animate-marquee {
		animation: marquee 40s linear infinite;
	}
</style>
