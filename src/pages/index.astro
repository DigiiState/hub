---
import Layout from '../layouts/Layout.astro';

// National Territory Data
const territories = [
	{ name: "Phoenix MD Septic", status: "Occupied", niche: "Septic", lat: "35%", left: "85%", state: "MD" },
	{ name: "Austin TX Junk Removal", status: "Open", niche: "Junk", lat: "70%", left: "45%", state: "TX" },
	{ name: "Miami FL Water Damage", status: "Occupied", niche: "Water", lat: "85%", left: "80%", state: "FL" },
	{ name: "Seattle WA Tree Service", status: "Open", niche: "Tree", lat: "15%", left: "15%", state: "WA" },
	{ name: "Chicago IL DUI Law", status: "Open", niche: "Law", lat: "35%", left: "60%", state: "IL" },
];

const liveLeads = [
	{ time: "8m ago", niche: "Septic", city: "Phoenix, MD" },
	{ time: "42m ago", niche: "Roofing", city: "Dallas, TX" },
	{ time: "1h ago", niche: "Law", city: "Annapolis, MD" },
	{ time: "3h ago", niche: "Water Damage", city: "Tampa, FL" },
];
---

<Layout title="DigiiState | Premier US Digital Real Estate Brokerage">
	<main class="bg-slate-950 text-white min-h-screen">
		<!-- 1. Live Lead Ticker (National) -->
		<div class="bg-blue-600/10 border-b border-blue-500/20 py-3 overflow-hidden whitespace-nowrap">
			<div class="inline-block animate-marquee uppercase tracking-widest text-[10px] font-black text-blue-400 px-6">
				{liveLeads.map(lead => (
					<span class="mr-12">📡 LIVE NETWORK PULSE: [{lead.time}] {lead.niche} Lead in {lead.city}</span>
				))}
				{liveLeads.map(lead => (
					<span class="mr-12">📡 LIVE NETWORK PULSE: [{lead.time}] {lead.niche} Lead in {lead.city}</span>
				))}
			</div>
		</div>

		<div class="max-w-6xl mx-auto px-6 py-12">
			<!-- Header -->
			<header class="flex justify-between items-center mb-24">
				<div class="text-2xl font-black tracking-tighter italic">
					Digii<span class="text-blue-500">State</span>
				</div>
				<nav class="flex gap-8 text-[10px] uppercase font-bold tracking-widest text-slate-500">
					<a href="#map" class="hover:text-white transition-colors">US Territories</a>
					<a href="#apply" class="text-blue-500 hover:text-blue-400 transition-colors border border-blue-500/30 px-4 py-2 rounded-full">Apply For Monopoly</a>
				</nav>
			</header>

			<!-- Hero Section (National Reach) -->
			<section class="mb-32 text-center max-w-4xl mx-auto">
				<h2 class="text-6xl md:text-8xl font-black mb-8 leading-[0.9] tracking-tighter">
					WE DOMINATE THE <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-500 to-indigo-400">SEARCH.</span><br/>
					YOU SCALE THE REVENUE.
				</h2>
				<p class="text-slate-400 text-xl leading-relaxed mb-12 max-w-2xl mx-auto">
					The nation's premier digital real estate brokerage. We build, rank, and rent hyper-local high-intent search assets across all 50 states.
				</p>
				<div class="flex flex-col md:flex-row justify-center gap-4">
					<a href="#map" class="bg-blue-600 hover:bg-blue-700 text-white px-10 py-5 font-black uppercase tracking-widest text-xs transition-all rounded shadow-xl shadow-blue-600/20">Explore US Territories</a>
					<a href="#apply" class="bg-white/5 hover:bg-white/10 text-white border border-white/10 px-10 py-5 font-black uppercase tracking-widest text-xs transition-all rounded">Partner Portal</a>
				</div>
			</section>

			<!-- 2. National Control Map -->
			<section id="map" class="mb-40">
				<div class="text-center mb-12">
					<h3 class="text-sm font-black uppercase tracking-[0.3em] text-blue-500 mb-4">National Control Map</h3>
					<p class="text-slate-500">Real-time occupancy status of DigiiState assets across the USA.</p>
				</div>
				
				<div class="relative bg-slate-900 border border-slate-800 rounded-3xl p-6 md:p-12 overflow-hidden shadow-2xl">
					<div class="aspect-[16/9] w-full bg-[url('https://upload.wikimedia.org/wikipedia/commons/3/32/Blank_US_Map_with_borders.svg')] bg-contain bg-center bg-no-repeat opacity-20 grayscale invert contrast-125 brightness-150"></div>
					
					<!-- National Markers -->
					{territories.map(t => (
						<div 
							class={`absolute w-3 h-3 md:w-4 md:h-4 rounded-full border-2 border-white shadow-[0_0_15px_rgba(255,255,255,0.5)] cursor-pointer hover:scale-125 transition-transform group`}
							style={`top: ${t.lat}; left: ${t.left}; background-color: ${t.status === 'Occupied' ? '#f59e0b' : '#10b981'}`}
						>
							<div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-4 w-48 bg-slate-900 border border-slate-700 p-4 rounded-xl opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none z-50">
								<div class="text-[10px] font-black uppercase text-blue-500 mb-1">{t.niche}</div>
								<div class="font-bold text-sm mb-2">{t.name}</div>
								<div class={`text-[10px] font-bold uppercase ${t.status === 'Occupied' ? 'text-orange-500' : 'text-green-500'}`}>
									{t.status === 'Occupied' ? '🔒 LEASED' : '🔓 AVAILABLE'}
								</div>
							</div>
						</div>
					))}
				</div>
			</section>

			<!-- 3. The "PPC Trap" Contrast -->
			<section class="mb-40 py-24 border-y border-slate-800">
				<div class="grid md:grid-cols-2 gap-16 items-center">
					<div>
						<h3 class="text-4xl font-black tracking-tighter mb-6 uppercase italic">Escape the <span class="text-red-500">PPC Trap.</span></h3>
						<p class="text-slate-400 leading-relaxed mb-6">
							Google Ads is a tax on your growth. You pay for every click—even the ones that don't call. When you stop paying, the leads stop.
						</p>
						<p class="text-slate-200 font-bold leading-relaxed">
							DigiiState gives you the "Digital Deed." You own the territory. No bidding wars. No click fraud. Just exclusive, high-intent volume at a flat predictable rate.
						</p>
					</div>
					<div class="grid grid-cols-2 gap-4">
						<div class="p-8 bg-white/5 border border-white/10 rounded-2xl">
							<div class="text-red-500 font-black text-2xl mb-2">PPC</div>
							<p class="text-xs text-slate-500 uppercase font-bold tracking-widest">Variable Cost<br/>Shared Leads<br/>Instant Shutoff</p>
						</div>
						<div class="p-8 bg-blue-600 border border-blue-400 rounded-2xl">
							<div class="text-white font-black text-2xl mb-2">DIGII</div>
							<p class="text-xs text-white/70 uppercase font-bold tracking-widest">Flat Weekly Rent<br/>100% Exclusive<br/>Equity Build</p>
						</div>
					</div>
				</div>
			</section>

			<!-- 4. Monopoly Application -->
			<section id="apply" class="grid md:grid-cols-2 gap-20 items-center pb-20">
				<div>
					<h3 class="text-4xl font-black tracking-tighter mb-8 uppercase italic">Secure Your <span class="text-blue-500 underline decoration-4">US Monopoly.</span></h3>
					<p class="text-slate-400 leading-relaxed mb-8">
						DigiiState is expanding into all major US metro areas. We only partner with one provider per niche per city. Apply now to secure your territory before your competition locks you out.
					</p>
					<ul class="space-y-4 font-bold text-sm uppercase tracking-widest text-slate-300">
						<li class="flex items-center gap-3"><span class="text-blue-500 text-xl">⚡</span> Exclusive Regional Rights</li>
						<li class="flex items-center gap-3"><span class="text-blue-500 text-xl">⚡</span> AI-Triaged Opportunities</li>
						<li class="flex items-center gap-3"><span class="text-blue-500 text-xl">⚡</span> Weekly Profit Analytics</li>
					</ul>
				</div>

				<div class="bg-slate-900 border border-slate-800 p-10 rounded-3xl shadow-2xl">
					<h4 class="text-xs font-black uppercase tracking-[0.2em] text-blue-500 mb-8">Territory Application</h4>
					<form class="space-y-6">
						<div>
							<label class="block text-[10px] font-black uppercase text-slate-500 mb-2 tracking-widest">Business Name</label>
							<input type="text" class="w-full bg-slate-950 border border-slate-800 p-4 rounded-xl outline-none focus:border-blue-500 transition-colors" placeholder="Company Legal Name" />
						</div>
						<div class="grid grid-cols-2 gap-4">
							<div>
								<label class="block text-[10px] font-black uppercase text-slate-500 mb-2 tracking-widest">Target State</label>
								<input type="text" class="w-full bg-slate-950 border border-slate-800 p-4 rounded-xl outline-none focus:border-blue-500 transition-colors" placeholder="e.g. TX, MD, FL" />
							</div>
							<div>
								<label class="block text-[10px] font-black uppercase text-slate-500 mb-2 tracking-widest">Target City</label>
								<input type="text" class="w-full bg-slate-950 border border-slate-800 p-4 rounded-xl outline-none focus:border-blue-500 transition-colors" placeholder="e.g. Dallas" />
							</div>
						</div>
						<div>
							<label class="block text-[10px] font-black uppercase text-slate-500 mb-2 tracking-widest">Estimated Ad Spend</label>
							<input type="text" class="w-full bg-slate-950 border border-slate-800 p-4 rounded-xl outline-none focus:border-blue-500 transition-colors" placeholder="$2,500 - $10,000" />
						</div>
						<button class="w-full bg-blue-600 hover:bg-blue-700 text-white py-5 font-black uppercase tracking-widest text-xs transition-all rounded-xl shadow-xl shadow-blue-600/20">Submit US Application</button>
					</form>
				</div>
			</section>

			<footer class="mt-40 pt-10 border-t border-slate-800 flex justify-between items-center text-[10px] font-bold uppercase tracking-widest text-slate-600">
				<div>&copy; 2026 DigiiState USA</div>
				<div>National Territory Expansion Agency</div>
			</footer>
		</div>
	</main>
</Layout>

<style>
	@keyframes marquee {
		0% { transform: translateX(0); }
		100% { transform: translateX(-50%); }
	}
	.animate-marquee {
		display: inline-block;
		animation: marquee 40s linear infinite;
	}
</style>
