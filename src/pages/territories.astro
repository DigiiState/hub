---
import Layout from '../layouts/Layout.astro';

const territories = [
	{ name: "Phoenix MD Septic", status: "Occupied", niche: "Septic", state: "MD", domain: "phoenixmdseptic.com" },
	{ name: "Clarksville Septic", status: "Open", niche: "Septic", state: "MD", domain: "clarksvillesepticpros.com" },
	{ name: "Gibson Island Tree", status: "Open", niche: "Tree", state: "MD", domain: "gibsonislandtreeremoval.com" },
	{ name: "Annapolis Tree", status: "Open", niche: "Tree", state: "MD", domain: "annapolistreepros.com" },
	{ name: "Austin TX Junk Removal", status: "Open", niche: "Junk", state: "TX", domain: "austin-junk.pages.dev" },
	{ name: "Miami FL Water Damage", status: "Occupied", niche: "Water", state: "FL", domain: "miami-water.pages.dev" },
];
---

<Layout title="Territory Portfolio | DigiiState HQ">
	<main class="bg-white text-slate-900 min-h-screen">
		<div class="max-w-6xl mx-auto px-6 py-20">
			<header class="flex justify-between items-center mb-32">
				<a href="/" class="text-2xl font-black tracking-tighter flex items-center gap-2 group cursor-pointer">
					<div class="w-10 h-10 bg-blue-600 rounded-xl flex items-center justify-center text-lg text-white shadow-lg shadow-blue-600/20 group-hover:scale-105 transition-transform">D</div>
					<div class="flex flex-col leading-none">
						<span class="text-slate-950">Digii<span class="text-blue-600">State</span></span>
						<span class="text-[8px] uppercase tracking-[0.4em] text-slate-400 font-bold">National Brokerage</span>
					</div>
				</a>
				<nav class="hidden lg:flex gap-12 text-[10px] uppercase font-black tracking-[0.3em] text-slate-400">
					<a href="/territories" class="text-blue-600">Portfolios</a>
					<a href="/#economics" class="hover:text-blue-600 transition-colors">Alpha Logic</a>
					<a href="/about" class="hover:text-blue-600 transition-colors">Brokerage</a>
				</nav>
			</header>

			<h1 class="text-5xl font-black uppercase tracking-tighter mb-20 text-slate-950">US Territory Portfolio</h1>

			<div class="grid gap-4">
				{territories.map(t => (
					<div class="flex flex-col md:flex-row justify-between items-center p-8 bg-slate-50 border border-slate-100 rounded-3xl hover:border-blue-200 transition-all group">
						<div class="flex flex-col mb-4 md:mb-0">
							<span class="text-[10px] font-black uppercase tracking-widest text-blue-600 bg-blue-50 px-2 py-1 rounded inline-block w-fit mb-2">{t.niche}</span>
							<b class="text-2xl font-black uppercase italic tracking-tight">{t.name}</b>
							<span class="text-sm text-slate-400 font-medium">{t.domain}</span>
						</div>
						<div class="flex items-center gap-8">
							<div class="text-right">
								<span class={`text-[10px] font-black uppercase tracking-widest block ${t.status === 'Occupied' ? 'text-amber-600' : 'text-emerald-600'}`}>Status</span>
								<b class="text-sm font-bold uppercase">{t.status === 'Occupied' ? '🔒 Exclusive Lease' : '🔓 Ready for Acquisition'}</b>
							</div>
							<a href={`/contact?territory=${t.name}`} class="bg-slate-950 text-white px-6 py-3 rounded-xl text-[10px] font-black uppercase tracking-widest hover:bg-blue-600 transition-all">
								{t.status === 'Occupied' ? 'Join Waitlist' : 'Acquire Rights'}
							</a>
						</div>
					</div>
				))}
			</div>
		</div>
	</main>
</Layout>
