---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="DigiiState - Premier US Digital Real Estate Brokerage. We build, rank, and rent hyper-local high-intent search assets across all 50 states." />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;700&display=swap" rel="stylesheet">
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-white text-[#0f172a] font-['IBM_Plex_Sans',_sans-serif] selection:bg-[#0040ff] selection:text-white antialiased">
		<slot />
	</body>
</html>

<style is:global>
	@tailwind base;
	@tailwind components;
	@tailwind utilities;

	:root {
		--accent: 0, 64, 255;
	}

	body {
		margin: 0;
		padding: 0;
	}

	/* Bloomberg-style typography polish */
	h1, h2, h3, h4 {
		font-weight: 700;
		letter-spacing: -0.02em;
	}

	.mono {
		font-family: 'IBM Plex Mono', monospace;
	}

	/* Custom Scrollbar */
	::-webkit-scrollbar {
		width: 6px;
	}
	::-webkit-scrollbar-track {
		background: #ffffff;
	}
	::-webkit-scrollbar-thumb {
		background: #e2e8f0;
	}
	::-webkit-scrollbar-thumb:hover {
		background: #cbd5e1;
	}
</style>
