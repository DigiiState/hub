---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="DigiiState - Maryland's Premier Digital Real Estate Brokerage" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-slate-50 text-slate-900 font-sans">
		<slot />
	</body>
</html>
<style is:global>
	:root {
		--accent: 59, 130, 246;
		--accent-light: 224, 204, 250;
		--accent-dark: 15, 23, 42;
	}
</style>
